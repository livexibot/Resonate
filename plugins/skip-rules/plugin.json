{
  "id": "skip-rules",
  "name": "Skip rules",
  "version": "1.0.0",
  "description": "Skips songs by artist, version or length.",
  "author": "Resonate",
  "main": "main.js",
  "permissions": ["player.read", "player.control"],
  "settings": [
    {
      "key": "artists",
      "type": "list",
      "title": "Always skip these artists",
      "description": "One name per line.",
      "placeholder": "Artist name",
      "default": []
    },
    {
      "key": "versions",
      "type": "list",
      "title": "Skip these versions",
      "description": "One per line, such as live, remix or sped up.",
      "placeholder": "live",
      "default": []
    },
    {
      "key": "songs",
      "type": "list",
      "title": "Always skip these songs",
      "description": "One per line, as title — artists.",
      "default": []
    },
    {
      "key": "longerThan",
      "type": "number",
      "title": "Skip songs longer than",
      "description": "0 keeps songs of any length.",
      "min": 0,
      "max": 120,
      "step": 1,
      "unit": "minutes",
      "default": 0
    },
    {
      "key": "shorterThan",
      "type": "number",
      "title": "Skip songs shorter than",
      "description": "0 keeps songs of any length.",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "seconds",
      "default": 0
    }
  ]
}
