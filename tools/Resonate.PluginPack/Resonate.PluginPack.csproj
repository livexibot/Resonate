<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Packs the plugins and the plugin helper for a release, and writes the
    catalog the app is built with (see .github/workflows). Not shipped.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Resonate.PluginPack</RootNamespace>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Resonate.Plugins\Resonate.Plugins.csproj" />
  </ItemGroup>

</Project>
