<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The helper that runs plugins: a small console program with a JavaScript
    engine (Jint), compiled ahead of time like the app. It is not part of
    the installer; Resonate downloads it from the release the first time a
    plugin is turned on. Any OS, so it is tested on Linux.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Resonate.PluginHost</RootNamespace>
    <AssemblyName>Resonate.PluginHost</AssemblyName>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The single "Jint produced trim warnings" notes; see ExpectJintTrimWarnings below. -->
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="prelude.js" LogicalName="prelude.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Resonate.Plugins\Resonate.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Resonate.Plugins.Tests" />
  </ItemGroup>

  <!--
    Jint's warnings come from its .NET interop (reflection, expression
    trees, loading namespaces), which plugins are never given: the helper
    does not enable it. They are folded into one note per assembly, so
    warnings in Resonate's own code still fail the build.
  -->
  <Target Name="ExpectJintTrimWarnings" AfterTargets="PrepareForILLink">
    <ItemGroup>
      <ManagedAssemblyToLink Condition="'%(Filename)' == 'Jint'">
        <TrimmerSingleWarn>true</TrimmerSingleWarn>
      </ManagedAssemblyToLink>
    </ItemGroup>
  </Target>

</Project>
