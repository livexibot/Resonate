<?xml version="1.0" encoding="utf-8"?>
<!--
  The design tokens every control reads. Colours live in the brushes below;
  ThemeService changes their Color at run time, so a new preset restyles the
  whole app at once without reloading anything. The starting values are the
  Midnight preset. Never put a colour straight on a control: add a token.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colour tokens -->
    <SolidColorBrush x:Key="ResonateBackgroundBrush" Color="#0F1014" />
    <SolidColorBrush x:Key="ResonateSidebarBrush" Color="#14151A" />
    <SolidColorBrush x:Key="ResonateSurfaceBrush" Color="#1A1C22" />
    <SolidColorBrush x:Key="ResonateSurfaceHoverBrush" Color="#23252D" />
    <SolidColorBrush x:Key="ResonateSurfacePressedBrush" Color="#2B2E37" />
    <SolidColorBrush x:Key="ResonateBorderBrush" Color="#262830" />
    <SolidColorBrush x:Key="ResonateTextPrimaryBrush" Color="#F2F3F5" />
    <SolidColorBrush x:Key="ResonateTextSecondaryBrush" Color="#A9ADB8" />
    <SolidColorBrush x:Key="ResonateTextTertiaryBrush" Color="#6F7480" />
    <SolidColorBrush x:Key="ResonateAccentBrush" Color="#8B7CFF" />
    <SolidColorBrush x:Key="ResonateAccentHoverBrush" Color="#9D90FF" />
    <SolidColorBrush x:Key="ResonateAccentPressedBrush" Color="#7868F2" />
    <SolidColorBrush x:Key="ResonateOnAccentBrush" Color="#0F1014" />
    <SolidColorBrush x:Key="ResonateTransparentBrush" Color="#00000000" />

    <!-- Shape tokens -->
    <CornerRadius x:Key="ResonateCornerSmall">4</CornerRadius>
    <CornerRadius x:Key="ResonateCornerMedium">8</CornerRadius>
    <CornerRadius x:Key="ResonateCornerLarge">12</CornerRadius>

    <!-- Type tokens -->
    <FontFamily x:Key="ResonateDisplayFont">Segoe UI Variable Display</FontFamily>
    <FontFamily x:Key="ResonateTextFont">Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="ResonateIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Built-in controls take their accent and hover colours from the tokens (lightweight styling). -->
    <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="ResonateSurfaceHoverBrush" />
    <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="ResonateSurfacePressedBrush" />
    <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="ResonateSurfacePressedBrush" />
    <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="ResonateSurfacePressedBrush" />
    <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="ResonateSurfacePressedBrush" />
    <StaticResource x:Key="ListViewItemSelectionIndicatorBrush" ResourceKey="ResonateAccentBrush" />
    <StaticResource x:Key="ListViewItemSelectionIndicatorPointerOverBrush" ResourceKey="ResonateAccentBrush" />
    <StaticResource x:Key="ListViewItemSelectionIndicatorPressedBrush" ResourceKey="ResonateAccentBrush" />
    <StaticResource x:Key="SliderTrackValueFill" ResourceKey="ResonateAccentBrush" />
    <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="ResonateAccentHoverBrush" />
    <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="ResonateAccentPressedBrush" />
    <StaticResource x:Key="SliderTrackFill" ResourceKey="ResonateSurfacePressedBrush" />
    <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="ResonateSurfacePressedBrush" />
    <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="ResonateSurfacePressedBrush" />
    <StaticResource x:Key="SliderThumbBackground" ResourceKey="ResonateAccentBrush" />
    <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="ResonateAccentHoverBrush" />
    <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="ResonateAccentPressedBrush" />
    <StaticResource x:Key="ProgressRingForegroundThemeBrush" ResourceKey="ResonateAccentBrush" />
    <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="ResonateAccentBrush" />
    <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="ResonateAccentHoverBrush" />
    <StaticResource x:Key="HyperlinkButtonForegroundPressed" ResourceKey="ResonateAccentPressedBrush" />

    <!-- Text styles -->
    <Style x:Key="ResonateDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ResonateDisplayFont}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ResonateTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="ResonateTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ResonateDisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ResonateTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ResonateBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ResonateTextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource ResonateTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ResonateSecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ResonateTextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource ResonateTextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ResonateCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ResonateTextFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource ResonateTextTertiaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- A round, quiet button for icons (player controls, toolbar). -->
    <Style x:Key="ResonateIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ResonateTransparentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ResonateTextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource ResonateIconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.BackgroundTransition>
                            <BrushTransition Duration="0:0:0.12" />
                        </Grid.BackgroundTransition>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource ResonateSurfaceHoverBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource ResonateTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource ResonateSurfacePressedBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource ResonateTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.35" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The main call to action: a pill in the accent colour. -->
    <Style x:Key="ResonateAccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ResonateAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ResonateOnAccentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource ResonateTextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="22,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="Root"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.BackgroundTransition>
                            <BrushTransition Duration="0:0:0.12" />
                        </Grid.BackgroundTransition>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource ResonateAccentHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource ResonateAccentPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The round play and pause button in the player bar. -->
    <Style
        x:Key="ResonatePlayButtonStyle"
        BasedOn="{StaticResource ResonateAccentButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource ResonateIconFont}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- A quiet, rounded secondary button. -->
    <Style x:Key="ResonateSubtleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ResonateSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ResonateTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ResonateBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource ResonateTextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="Root"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.BackgroundTransition>
                            <BrushTransition Duration="0:0:0.12" />
                        </Grid.BackgroundTransition>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource ResonateSurfaceHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource ResonateSurfacePressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
