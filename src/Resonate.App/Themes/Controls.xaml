<?xml version="1.0" encoding="utf-8"?>
<!-- Templates for Resonate's own controls. Their look comes from Tokens.xaml. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Resonate.App.Controls">

    <!-- The content, with the theme's shadow behind it (see Elevation.cs). -->
    <Style TargetType="controls:Elevation">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:Elevation">
                    <Grid>
                        <Border
                            x:Name="HardShadow"
                            Background="{StaticResource ResonateShadowBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Visibility="Collapsed" />
                        <Border x:Name="ShadowHost" />
                        <ContentPresenter
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The progress and volume bars (see SeekBar.cs, which sizes the parts for the theme's bar style). -->
    <Style TargetType="controls:SeekBar">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="SmallChange" Value="5" />
        <Setter Property="LargeChange" Value="15" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SeekBar">
                    <Grid x:Name="Root" Background="{StaticResource ResonateTransparentBrush}">
                        <Grid
                            x:Name="TrackArea"
                            Height="4"
                            VerticalAlignment="Center">
                            <Border x:Name="Track" Background="{StaticResource ResonateTrackBrush}" />
                            <Border x:Name="Fill" Background="{StaticResource ResonateAccentBrush}" />
                        </Grid>
                        <!-- SeekBar.cs draws the wave in here. -->
                        <Grid
                            x:Name="WaveHost"
                            Height="16"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
                        <Border
                            x:Name="Thumb"
                            Width="12"
                            Height="12"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{StaticResource ResonateAccentBrush}"
                            IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A setting on a card: name and explanation on the left, the control on the right (or below, see SettingRow.ContentBelow). -->
    <Style TargetType="controls:SettingRow">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{StaticResource ResonateControlBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ResonateBorderBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource ResonatePanelBorderThickness}" />
        <Setter Property="CornerRadius" Value="{ThemeResource ResonateCornerMedium}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="54" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingRow">
                    <Grid
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        ColumnSpacing="20"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ContentPlacement">
                                <VisualState x:Name="Beside" />
                                <VisualState x:Name="Below">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.(Grid.Row)" Value="1" />
                                        <Setter Target="Presenter.(Grid.Column)" Value="0" />
                                        <Setter Target="Presenter.(Grid.ColumnSpan)" Value="2" />
                                        <Setter Target="Presenter.HorizontalAlignment" Value="Stretch" />
                                        <Setter Target="Presenter.Margin" Value="0,10,0,0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource ResonateBodyTextStyle}" Text="{TemplateBinding Header}" />
                            <TextBlock
                                Foreground="{StaticResource ResonateTextSecondaryBrush}"
                                Style="{StaticResource ResonateCaptionTextStyle}"
                                Text="{TemplateBinding Description}"
                                TextWrapping="Wrap"
                                Visibility="{TemplateBinding DescriptionVisibility}" />
                        </StackPanel>
                        <ContentPresenter
                            x:Name="Presenter"
                            Grid.Column="1"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A section of Settings that folds away (see SettingsGroup.cs): its heading
        is a button across the pane with a chevron, and the settings sit under it.
        The button reaches a little past the settings on each side, so the
        heading's text lines up with them and its hover fill has room.
    -->
    <Style TargetType="controls:SettingsGroup">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingsGroup">
                    <StackPanel>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ExpandStates">
                                <VisualState x:Name="Expanded" />
                                <VisualState x:Name="Collapsed">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Visibility" Value="Collapsed" />
                                        <Setter Target="Chevron.Glyph" Value="&#xE76C;" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Button
                            x:Name="HeaderButton"
                            Margin="-10,0,-10,0"
                            Style="{StaticResource ResonateSectionHeaderButtonStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ResonateTitleTextStyle}" Text="{TemplateBinding Header}" />
                                <FontIcon
                                    x:Name="Chevron"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource ResonateIconFont}"
                                    FontSize="12"
                                    Foreground="{StaticResource ResonateTextSecondaryBrush}"
                                    Glyph="&#xE70D;" />
                            </Grid>
                        </Button>
                        <ContentPresenter
                            x:Name="Presenter"
                            Margin="0,8,0,0"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            Content="{TemplateBinding Content}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
