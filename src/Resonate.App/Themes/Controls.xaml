<?xml version="1.0" encoding="utf-8"?>
<!-- Templates for Resonate's own controls. Their look comes from Tokens.xaml. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Resonate.App.Controls">

    <!-- The content, with the theme's shadow behind it (see Elevation.cs). -->
    <Style TargetType="controls:Elevation">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:Elevation">
                    <Grid>
                        <Border
                            x:Name="HardShadow"
                            Background="{StaticResource ResonateShadowBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Visibility="Collapsed" />
                        <Border x:Name="ShadowHost" />
                        <ContentPresenter
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The progress and volume bars (see SeekBar.cs, which sizes the parts for the theme's bar style). -->
    <Style TargetType="controls:SeekBar">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="SmallChange" Value="5" />
        <Setter Property="LargeChange" Value="15" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SeekBar">
                    <Grid x:Name="Root" Background="{StaticResource ResonateTransparentBrush}">
                        <Grid
                            x:Name="TrackArea"
                            Height="4"
                            VerticalAlignment="Center">
                            <Border x:Name="Track" Background="{StaticResource ResonateTrackBrush}" />
                            <Border x:Name="Fill" Background="{StaticResource ResonateAccentBrush}" />
                        </Grid>
                        <!-- SeekBar.cs draws the wave in here. -->
                        <Grid
                            x:Name="WaveHost"
                            Height="16"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
                        <Border
                            x:Name="Thumb"
                            Width="12"
                            Height="12"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{StaticResource ResonateAccentBrush}"
                            IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A setting on a card: name and explanation on the left, the control on the right. -->
    <Style TargetType="controls:SettingRow">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{StaticResource ResonateControlBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ResonateBorderBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource ResonatePanelBorderThickness}" />
        <Setter Property="CornerRadius" Value="{ThemeResource ResonateCornerMedium}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="62" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingRow">
                    <Grid
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        ColumnSpacing="20"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource ResonateBodyTextStyle}" Text="{TemplateBinding Header}" />
                            <TextBlock
                                Style="{StaticResource ResonateCaptionTextStyle}"
                                Text="{TemplateBinding Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ContentPresenter
                            Grid.Column="1"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
