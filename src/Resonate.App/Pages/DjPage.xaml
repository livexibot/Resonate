<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Resonate.App.Pages.DjPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Resonate.App.Controls"
    Background="{StaticResource ResonateTransparentBrush}">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource ResonatePagePadding}" Spacing="24">
            <Grid ColumnSpacing="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- A glow of the accent, fading downwards; it reaches past the page's padding to the panel's edges. -->
                <Border
                    Grid.ColumnSpan="2"
                    Margin="-32,-32,-32,-24"
                    Background="{StaticResource ResonateHeroGradientBrush}"
                    CornerRadius="{ThemeResource ResonateCornerLarge}"
                    IsHitTestVisible="False" />
                <controls:Elevation
                    Width="232"
                    Height="232"
                    CornerRadius="{ThemeResource ResonateCornerLarge}"
                    Level="Item" />
                <Grid
                    x:Name="CoverFrame"
                    Width="232"
                    Height="232"
                    CornerRadius="{ThemeResource ResonateCornerLarge}">
                    <FontIcon
                        FontFamily="{StaticResource ResonateIconFont}"
                        FontSize="64"
                        Foreground="#E6FFFFFF"
                        Glyph="&#xE7F6;" />
                </Grid>
                <!-- Lines stay short enough to read on a wide window. -->
                <StackPanel
                    Grid.Column="1"
                    MaxWidth="480"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Spacing="8">
                    <TextBlock Style="{StaticResource ResonateEyebrowTextStyle}" Text="IN THE SPOTIFY APP" />
                    <TextBlock Style="{StaticResource ResonateDisplayTextStyle}" Text="DJ" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="StartButton"
                    Click="OnStartClick"
                    Style="{StaticResource ResonateAccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontFamily="{StaticResource ResonateIconFont}"
                            FontSize="14"
                            Glyph="&#xF5B0;" />
                        <TextBlock x:Name="StartText" Text="Start DJ" />
                    </StackPanel>
                </Button>
                <ProgressRing
                    x:Name="WaitingRing"
                    Width="20"
                    Height="20"
                    IsActive="False" />
            </StackPanel>

            <Border
                MaxWidth="760"
                Padding="16,12"
                HorizontalAlignment="Left"
                Background="{StaticResource ResonateSurfaceHoverBrush}"
                CornerRadius="{ThemeResource ResonateCornerMedium}">
                <TextBlock
                    x:Name="StatusText"
                    Style="{StaticResource ResonateSecondaryTextStyle}"
                    TextWrapping="Wrap" />
            </Border>

            <!-- Room for a player hovering over the page (see IPlayerInset). -->
            <Border x:Name="PlayerSpace" Height="0" />
        </StackPanel>
    </ScrollViewer>
</Page>
