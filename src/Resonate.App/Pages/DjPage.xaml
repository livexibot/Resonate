<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Resonate.App.Pages.DjPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Resonate.App.Controls"
    Background="{StaticResource ResonateTransparentBrush}">

    <!--
      Resonate's own DJ (Services/DjService.cs): themed sets from the user's
      music, a button to switch them up, and a voice that introduces each.
    -->
    <ScrollViewer>
        <StackPanel Padding="{StaticResource ResonatePagePadding}" Spacing="24">
            <Grid ColumnSpacing="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- A glow of the accent, fading downwards; it reaches past the page's padding to the panel's edges. -->
                <Border
                    Grid.ColumnSpan="2"
                    Margin="-32,-32,-32,-24"
                    Background="{StaticResource ResonateHeroGradientBrush}"
                    CornerRadius="{ThemeResource ResonateCornerLarge}"
                    IsHitTestVisible="False" />
                <controls:Elevation
                    Width="232"
                    Height="232"
                    CornerRadius="{ThemeResource ResonateCornerLarge}"
                    Level="Item" />
                <Grid
                    x:Name="CoverFrame"
                    Width="232"
                    Height="232"
                    CornerRadius="{ThemeResource ResonateCornerLarge}">
                    <FontIcon
                        x:Name="CoverGlyph"
                        FontFamily="{StaticResource ResonateIconFont}"
                        FontSize="64"
                        Glyph="&#xE7F6;" />
                </Grid>
                <StackPanel
                    Grid.Column="1"
                    MaxWidth="560"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Spacing="8">
                    <TextBlock Style="{StaticResource ResonateEyebrowTextStyle}" Text="YOUR DJ" />
                    <TextBlock Style="{StaticResource ResonateDisplayTextStyle}" Text="DJ" />
                    <TextBlock
                        x:Name="NowText"
                        Style="{StaticResource ResonateSecondaryTextStyle}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="StartButton"
                    Click="OnStartClick"
                    Style="{StaticResource ResonateAccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            x:Name="StartGlyph"
                            FontFamily="{StaticResource ResonateIconFont}"
                            FontSize="14"
                            Glyph="&#xE768;" />
                        <TextBlock x:Name="StartText" Text="Start DJ" />
                    </StackPanel>
                </Button>
                <ProgressRing
                    x:Name="WaitingRing"
                    Width="20"
                    Height="20"
                    IsActive="False" />
                <ToggleSwitch
                    x:Name="VoiceSwitch"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Voice"
                    OffContent="Voice"
                    OnContent="Voice"
                    Toggled="OnVoiceToggled" />
            </StackPanel>

            <TextBlock
                x:Name="StatusText"
                Style="{StaticResource ResonateSecondaryTextStyle}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <!-- The sets after the one playing now -->
            <StackPanel
                x:Name="SetsPanel"
                Spacing="12"
                Visibility="Collapsed">
                <TextBlock Style="{StaticResource ResonateSectionTextStyle}" Text="Up next" />
                <StackPanel x:Name="SetsList" Spacing="8" />
            </StackPanel>

            <!-- Room for a player hovering over the page (see IPlayerInset). -->
            <Border x:Name="PlayerSpace" Height="0" />
        </StackPanel>
    </ScrollViewer>
</Page>
