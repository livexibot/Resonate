<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Resonate.App.Pages.PlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Resonate.App.ViewModels"
    Background="{StaticResource ResonateTransparentBrush}">

    <Grid>
        <ListView
            x:Name="TrackList"
            Padding="16,0,16,24"
            DoubleTapped="OnTrackDoubleTapped"
            ItemsSource="{x:Bind Tracks}"
            KeyDown="OnTrackListKeyDown"
            SelectionMode="Single">
            <ListView.Header>
                <StackPanel Padding="12,36,12,8" Spacing="28">
                    <Grid ColumnSpacing="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="184" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            x:Name="CoverFrame"
                            Width="184"
                            Height="184"
                            CornerRadius="{StaticResource ResonateCornerLarge}">
                            <FontIcon
                                x:Name="CoverGlyph"
                                FontFamily="{StaticResource ResonateIconFont}"
                                FontSize="56"
                                Foreground="#E6FFFFFF"
                                Glyph="&#xEB52;"
                                Visibility="Collapsed" />
                            <Image x:Name="CoverImage" Stretch="UniformToFill" />
                        </Grid>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Spacing="8">
                            <TextBlock
                                x:Name="KindText"
                                CharacterSpacing="60"
                                Style="{StaticResource ResonateCaptionTextStyle}"
                                Text="PLAYLIST" />
                            <TextBlock
                                x:Name="TitleText"
                                Style="{StaticResource ResonateDisplayTextStyle}"
                                Text=" " />
                            <TextBlock
                                x:Name="DescriptionText"
                                MaxLines="2"
                                Style="{StaticResource ResonateSecondaryTextStyle}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <TextBlock x:Name="DetailsText" Style="{StaticResource ResonateCaptionTextStyle}" />
                            <StackPanel
                                Margin="0,10,0,0"
                                Orientation="Horizontal"
                                Spacing="12">
                                <Button
                                    x:Name="PlayButton"
                                    Click="OnPlayClick"
                                    Style="{StaticResource ResonateAccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            FontFamily="{StaticResource ResonateIconFont}"
                                            FontSize="14"
                                            Glyph="&#xE768;" />
                                        <TextBlock Text="Play" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="OpenInSpotifyButton"
                                    Click="OnOpenInSpotifyClick"
                                    Content="Open in Spotify"
                                    Style="{StaticResource ResonateSubtleButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border
                        x:Name="HiddenNotice"
                        Padding="16,12"
                        Background="{StaticResource ResonateSurfaceHoverBrush}"
                        CornerRadius="{StaticResource ResonateCornerMedium}"
                        Visibility="Collapsed">
                        <TextBlock
                            Style="{StaticResource ResonateSecondaryTextStyle}"
                            Text="Spotify only lets apps like Resonate list the songs of playlists you own or collaborate on. You can still play this playlist with the Play button."
                            TextWrapping="Wrap" />
                    </Border>

                    <!-- Column headings; widths match the rows below. -->
                    <Grid
                        x:Name="ColumnHeadings"
                        Padding="4,0,0,8"
                        BorderBrush="{StaticResource ResonateBorderBrush}"
                        BorderThickness="0,0,0,1"
                        ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Style="{StaticResource ResonateCaptionTextStyle}"
                            Text="#"
                            TextAlignment="Right" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource ResonateCaptionTextStyle}"
                            Text="Title" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource ResonateCaptionTextStyle}"
                            Text="Album" />
                        <FontIcon
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            FontFamily="{StaticResource ResonateIconFont}"
                            FontSize="12"
                            Foreground="{StaticResource ResonateTextTertiaryBrush}"
                            Glyph="&#xE823;" />
                    </Grid>
                </StackPanel>
            </ListView.Header>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TrackRow">
                    <Grid
                        Height="58"
                        ColumnSpacing="16"
                        Opacity="{x:Bind RowOpacity}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource ResonateSecondaryTextStyle}"
                            Text="{x:Bind Number}"
                            TextAlignment="Right" />
                        <Grid Grid.Column="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Width="40"
                                Height="40"
                                Background="{x:Bind PlaceholderBrush}"
                                CornerRadius="{StaticResource ResonateCornerSmall}">
                                <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Foreground="{x:Bind TitleBrush, Mode=OneWay}"
                                    Style="{StaticResource ResonateBodyTextStyle}"
                                    Text="{x:Bind Title}" />
                                <TextBlock Style="{StaticResource ResonateSecondaryTextStyle}" Text="{x:Bind Artists}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource ResonateSecondaryTextStyle}"
                            Text="{x:Bind Album}" />
                        <TextBlock
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource ResonateSecondaryTextStyle}"
                            Text="{x:Bind Duration}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressRing
            x:Name="LoadingRing"
            Width="36"
            Height="36"
            IsActive="False" />
    </Grid>
</Page>
