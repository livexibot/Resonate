<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Resonate.App.Pages.TracksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Resonate.App.Controls"
    xmlns:vm="using:Resonate.App.ViewModels"
    Background="{StaticResource ResonateTransparentBrush}">

    <Grid>
        <ListView
            x:Name="TrackList"
            Padding="16,0,16,24"
            SizeChanged="OnTrackListSizeChanged"
            ContextRequested="OnTrackContextRequested"
            DoubleTapped="OnTrackDoubleTapped"
            DragItemsCompleted="OnDragItemsCompleted"
            DragItemsStarting="OnDragItemsStarting"
            KeyDown="OnTrackListKeyDown"
            SelectionMode="Single">
            <ListView.Header>
                <Grid>
                    <!-- The cover's colour, fading towards the songs (Helpers/CoverHero.cs). It runs to the panel's edges. -->
                    <Border
                        x:Name="Hero"
                        Margin="-16,0,-16,0"
                        CornerRadius="{ThemeResource ResonateCornerLarge}"
                        IsHitTestVisible="False" />
                    <StackPanel Padding="16,32,16,8" Spacing="24">
                        <Grid ColumnSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="CoverColumn" Width="232" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:Elevation
                                x:Name="CoverShadow"
                                Width="232"
                                Height="232"
                                CornerRadius="{ThemeResource ResonateCornerLarge}"
                                Level="Item" />
                            <Grid
                                x:Name="CoverFrame"
                                Width="232"
                                Height="232"
                                CornerRadius="{ThemeResource ResonateCornerLarge}">
                                <FontIcon
                                    x:Name="CoverGlyph"
                                    FontFamily="{StaticResource ResonateIconFont}"
                                    FontSize="56"
                                    Foreground="#E6FFFFFF"
                                    Visibility="Collapsed" />
                                <Image x:Name="CoverImage" Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Spacing="8">
                                <TextBlock x:Name="KindText" Style="{StaticResource ResonateEyebrowTextStyle}" />
                                <TextBlock
                                    x:Name="TitleText"
                                    MaxLines="2"
                                    Style="{StaticResource ResonateDisplayTextStyle}"
                                    Text=" "
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    x:Name="DescriptionText"
                                    MaxLines="2"
                                    Style="{StaticResource ResonateSecondaryTextStyle}"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <StackPanel
                                        x:Name="ArtistLinks"
                                        Orientation="Horizontal"
                                        Spacing="4" />
                                    <TextBlock
                                        x:Name="DetailsText"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ResonateCaptionTextStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Play, shuffle, filter and sort (filter and sort move to a second row when narrow) -->
                        <Grid
                            x:Name="ActionsGrid"
                            ColumnSpacing="12"
                            RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- The filter takes nearly all the free space, up to 220, and shrinks before the sort button is cut off. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100*" MaxWidth="220" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="PlayButton"
                                Click="OnPlayClick"
                                Style="{StaticResource ResonateAccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontFamily="{StaticResource ResonateIconFont}"
                                        FontSize="14"
                                        Glyph="&#xF5B0;" />
                                    <TextBlock Text="Play" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="ShuffleButton"
                                Grid.Column="1"
                                Width="40"
                                Height="40"
                                AutomationProperties.Name="Shuffle play"
                                Click="OnShuffleClick"
                                Content="&#xE8B1;"
                                CornerRadius="{ThemeResource ResonatePlayButtonCorner}"
                                Style="{StaticResource ResonateIconButtonStyle}"
                                ToolTipService.ToolTip="Shuffle play (truly random)" />
                            <Button
                                x:Name="OpenInSpotifyButton"
                                Grid.Column="2"
                                AutomationProperties.Name="Open in Spotify"
                                Click="OnOpenInSpotifyClick"
                                Style="{StaticResource ResonateSubtleButtonStyle}">
                                <Grid>
                                    <TextBlock x:Name="OpenInSpotifyText" Text="Open in Spotify" />
                                    <FontIcon
                                        x:Name="OpenInSpotifyIcon"
                                        FontFamily="{StaticResource ResonateIconFont}"
                                        FontSize="14"
                                        Glyph="&#xE8A7;"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Button>
                            <TextBox
                                x:Name="FilterBox"
                                Grid.Column="4"
                                MinHeight="40"
                                Padding="16,9,12,9"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Filter songs"
                                CornerRadius="{ThemeResource ResonateCornerInput}"
                                PlaceholderText="Filter"
                                TextChanged="OnFilterChanged" />
                            <Button
                                x:Name="SortButton"
                                Grid.Column="5"
                                AutomationProperties.Name="Sort songs"
                                Style="{StaticResource ResonateSubtleButtonStyle}"
                                ToolTipService.ToolTip="Sort">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontFamily="{StaticResource ResonateIconFont}"
                                        FontSize="14"
                                        Glyph="&#xE8CB;" />
                                    <TextBlock x:Name="SortText" Text="Custom order" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedRight" />
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <Border
                            x:Name="HiddenNotice"
                            Padding="16,12"
                            Background="{StaticResource ResonateSurfaceHoverBrush}"
                            CornerRadius="{ThemeResource ResonateCornerMedium}"
                            Visibility="Collapsed">
                            <TextBlock
                                Style="{StaticResource ResonateSecondaryTextStyle}"
                                Text="Spotify only lets apps like Resonate list the songs of playlists you own or collaborate on. You can still play this playlist with the Play and Shuffle buttons."
                                TextWrapping="Wrap" />
                        </Border>

                        <!--
                          Column headings; widths match the rows below, whose content reaches
                          4 further right than the header's. Click one to sort by it.
                        -->
                        <Grid
                            x:Name="ColumnHeadings"
                            Margin="0,0,-4,0"
                            Padding="0,0,0,8"
                            BorderBrush="{StaticResource ResonateBorderBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="5*" />
                                <ColumnDefinition x:Name="AlbumHeadingColumn" Width="3*" />
                                <ColumnDefinition x:Name="AddedHeadingColumn" Width="132" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Width="{ThemeResource ResonateTrackNumberWidth}"
                                Margin="0,0,12,0"
                                Style="{StaticResource ResonateCaptionTextStyle}"
                                Text="#"
                                TextAlignment="Right" />
                            <StackPanel
                                x:Name="TitleHeading"
                                Grid.Column="1"
                                Background="{StaticResource ResonateTransparentBrush}"
                                Orientation="Horizontal"
                                Spacing="6"
                                Tapped="OnHeadingTapped"
                                Tag="Title">
                                <TextBlock Style="{StaticResource ResonateCaptionTextStyle}" Text="Title" />
                                <FontIcon
                                    x:Name="TitleArrow"
                                    FontFamily="{StaticResource ResonateIconFont}"
                                    FontSize="10"
                                    Foreground="{StaticResource ResonateAccentBrush}"
                                    Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel
                                x:Name="AlbumHeading"
                                Grid.Column="2"
                                Background="{StaticResource ResonateTransparentBrush}"
                                Orientation="Horizontal"
                                Spacing="6"
                                Tapped="OnHeadingTapped"
                                Tag="Album">
                                <TextBlock Style="{StaticResource ResonateCaptionTextStyle}" Text="Album" />
                                <FontIcon
                                    x:Name="AlbumArrow"
                                    FontFamily="{StaticResource ResonateIconFont}"
                                    FontSize="10"
                                    Foreground="{StaticResource ResonateAccentBrush}"
                                    Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel
                                x:Name="AddedHeading"
                                Grid.Column="3"
                                Background="{StaticResource ResonateTransparentBrush}"
                                Orientation="Horizontal"
                                Spacing="6"
                                Tapped="OnHeadingTapped"
                                Tag="DateAdded">
                                <TextBlock Style="{StaticResource ResonateCaptionTextStyle}" Text="Date added" />
                                <FontIcon
                                    x:Name="AddedArrow"
                                    FontFamily="{StaticResource ResonateIconFont}"
                                    FontSize="10"
                                    Foreground="{StaticResource ResonateAccentBrush}"
                                    Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel
                                x:Name="DurationHeading"
                                Grid.Column="5"
                                HorizontalAlignment="Right"
                                Background="{StaticResource ResonateTransparentBrush}"
                                Orientation="Horizontal"
                                Spacing="6"
                                Tapped="OnHeadingTapped"
                                Tag="Duration">
                                <FontIcon
                                    x:Name="DurationArrow"
                                    FontFamily="{StaticResource ResonateIconFont}"
                                    FontSize="10"
                                    Foreground="{StaticResource ResonateAccentBrush}"
                                    Visibility="Collapsed" />
                                <FontIcon
                                    FontFamily="{StaticResource ResonateIconFont}"
                                    FontSize="12"
                                    Foreground="{StaticResource ResonateTextTertiaryBrush}"
                                    Glyph="&#xE823;" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ListView.Header>

            <ListView.Footer>
                <StackPanel>
                    <TextBlock
                        x:Name="EmptyText"
                        Margin="16,24"
                        Style="{StaticResource ResonateSecondaryTextStyle}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <!-- Room for a player hovering over the page (see IPlayerInset). -->
                    <Border x:Name="PlayerSpace" Height="0" />
                </StackPanel>
            </ListView.Footer>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TrackRow">
                    <Grid
                        MinHeight="56"
                        Background="{StaticResource ResonateTransparentBrush}"
                        Opacity="{x:Bind RowOpacity}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="{x:Bind Columns.AlbumWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Columns.AddedWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Width="{ThemeResource ResonateTrackNumberWidth}"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource ResonateSecondaryTextStyle}"
                            Text="{x:Bind Number, Mode=OneWay}"
                            TextAlignment="Right" />
                        <Grid
                            Grid.Column="1"
                            Margin="0,0,16,0"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Width="40"
                                Height="40"
                                Background="{x:Bind PlaceholderBrush}"
                                CornerRadius="{ThemeResource ResonateCornerSmall}">
                                <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Foreground="{x:Bind TitleBrush, Mode=OneWay}"
                                    Style="{StaticResource ResonateBodyTextStyle}"
                                    Text="{x:Bind Title}" />
                                <TextBlock Style="{StaticResource ResonateSecondaryTextStyle}" Text="{x:Bind Artists}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Grid.Column="2"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource ResonateSecondaryTextStyle}"
                            Text="{x:Bind Album}" />
                        <TextBlock
                            Grid.Column="3"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource ResonateSecondaryTextStyle}"
                            Text="{x:Bind DateAdded}" />
                        <Button
                            Grid.Column="4"
                            Width="32"
                            Height="32"
                            AutomationProperties.Name="{x:Bind HeartLabel, Mode=OneWay}"
                            Click="OnHeartClick"
                            Content="{x:Bind HeartGlyph, Mode=OneWay}"
                            FontSize="14"
                            Foreground="{x:Bind HeartBrush, Mode=OneWay}"
                            Style="{StaticResource ResonateIconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind HeartLabel, Mode=OneWay}"
                            Visibility="{x:Bind HeartVisibility}" />
                        <TextBlock
                            Grid.Column="5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource ResonateSecondaryTextStyle}"
                            Text="{x:Bind Duration}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressRing
            x:Name="LoadingRing"
            Width="36"
            Height="36"
            IsActive="False" />
    </Grid>
</Page>
