<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Resonate.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Resonate.App.Controls"
    xmlns:helpers="using:Resonate.App.Helpers"
    xmlns:vm="using:Resonate.App.ViewModels"
    Background="{StaticResource ResonateTransparentBrush}">

    <Page.Resources>
        <!-- The cards rise under the pointer (HoverLift) instead of getting a grey square behind them. -->
        <StaticResource x:Key="GridViewItemBackgroundPointerOver" ResourceKey="ResonateTransparentBrush" />
        <StaticResource x:Key="GridViewItemBackgroundPressed" ResourceKey="ResonateTransparentBrush" />

        <!-- Listening over the past day or week: the minutes, a chart of when, the top artist and the top song. -->
        <DataTemplate x:Key="StatCardTemplate" x:DataType="vm:StatCard">
            <Border
                Padding="20,18,20,18"
                Background="{StaticResource ResonateSurfaceHoverBrush}"
                BorderBrush="{StaticResource ResonateBorderBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ResonateCornerLarge}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ResonateEyebrowTextStyle}" Text="{x:Bind Heading}" />
                        <TextBlock
                            Grid.Column="1"
                            AutomationProperties.Name="{x:Bind TrendTip}"
                            Style="{StaticResource ResonateCaptionTextStyle}"
                            Text="{x:Bind Trend}"
                            ToolTipService.ToolTip="{x:Bind TrendTip}"
                            Visibility="{x:Bind TrendVisibility}" />
                    </Grid>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        ToolTipService.ToolTip="{x:Bind MinutesNote}">
                        <TextBlock
                            FontSize="{ThemeResource ResonateFontSize44}"
                            FontWeight="Bold"
                            Style="{StaticResource ResonateDisplayTextStyle}"
                            Text="{x:Bind Minutes}" />
                        <TextBlock
                            Margin="0,0,0,10"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource ResonateSecondaryTextStyle}"
                            Text="{x:Bind MinutesDetail}" />
                    </StackPanel>
                    <controls:BarStrip Series="{x:Bind Bars}" />
                    <StackPanel Spacing="10" Visibility="{x:Bind TopVisibility}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Width="36"
                                Height="36"
                                Background="{x:Bind ArtistPlaceholder}"
                                CornerRadius="18">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{ThemeResource ResonateTextFont}"
                                    FontSize="{ThemeResource ResonateFontSize13}"
                                    FontWeight="SemiBold"
                                    Foreground="{x:Bind ArtistInitialsBrush}"
                                    Text="{x:Bind ArtistInitials}" />
                                <Image Source="{x:Bind ArtistImage, Mode=OneWay}" Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="1">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Style="{StaticResource ResonateBodyTextStyle}"
                                    Text="{x:Bind ArtistName}" />
                                <TextBlock Style="{StaticResource ResonateCaptionTextStyle}" Text="{x:Bind ArtistDetail}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Width="36"
                                Height="36"
                                Background="{x:Bind SongPlaceholder}"
                                CornerRadius="{ThemeResource ResonateCornerSmall}">
                                <Image Source="{x:Bind SongImage}" Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="1">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Style="{StaticResource ResonateBodyTextStyle}"
                                    Text="{x:Bind SongTitle}" />
                                <TextBlock Style="{StaticResource ResonateCaptionTextStyle}" Text="{x:Bind SongDetail}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource ResonateSecondaryTextStyle}"
                        Text="{x:Bind EmptyText}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind EmptyVisibility}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--
          A daily mix: four of its albums' covers in a square (or the artist's
          picture), fading into the mix's colour under its big number. The play
          button shows under the pointer and plays it without opening it.
        -->
        <DataTemplate x:Key="MixCardTemplate" x:DataType="vm:MixCard">
            <controls:HoverLift Width="176" Padding="0,0,0,10">
                <StackPanel Spacing="2">
                    <Grid
                        Width="176"
                        Height="176"
                        Margin="0,0,0,8"
                        Background="{x:Bind PlaceholderBrush}"
                        CornerRadius="{ThemeResource ResonateCornerLarge}">
                        <Grid Visibility="{x:Bind MosaicVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Background="{x:Bind TopLeft.Placeholder}">
                                <Image Source="{x:Bind TopLeft.Image}" Stretch="UniformToFill" />
                            </Grid>
                            <Grid Grid.Column="1" Background="{x:Bind TopRight.Placeholder}">
                                <Image Source="{x:Bind TopRight.Image}" Stretch="UniformToFill" />
                            </Grid>
                            <Grid Grid.Row="1" Background="{x:Bind BottomLeft.Placeholder}">
                                <Image Source="{x:Bind BottomLeft.Image}" Stretch="UniformToFill" />
                            </Grid>
                            <Grid
                                Grid.Row="1"
                                Grid.Column="1"
                                Background="{x:Bind BottomRight.Placeholder}">
                                <Image Source="{x:Bind BottomRight.Image}" Stretch="UniformToFill" />
                            </Grid>
                        </Grid>
                        <Image
                            Source="{x:Bind Portrait}"
                            Stretch="UniformToFill"
                            Visibility="{x:Bind PortraitVisibility}" />
                        <Border Background="{x:Bind ScrimBrush}" />
                        <StackPanel Margin="14,0,14,12" VerticalAlignment="Bottom">
                            <TextBlock
                                CharacterSpacing="140"
                                FontFamily="{ThemeResource ResonateTextFont}"
                                FontSize="{ThemeResource ResonateFontSize10}"
                                FontWeight="SemiBold"
                                Foreground="#E6FFFFFF"
                                Text="{x:Bind Eyebrow}" />
                            <TextBlock
                                Margin="0,-6,0,-10"
                                FontFamily="{ThemeResource ResonateDisplayFont}"
                                FontSize="{ThemeResource ResonateFontSize60}"
                                FontWeight="Bold"
                                Foreground="#FFFFFFFF"
                                Text="{x:Bind Numeral}"
                                Visibility="{x:Bind NumeralVisibility}" />
                            <FontIcon
                                Margin="0,12,0,4"
                                HorizontalAlignment="Left"
                                FontFamily="{StaticResource ResonateIconFont}"
                                FontSize="40"
                                Foreground="#FFFFFFFF"
                                Glyph="{x:Bind Glyph}"
                                Visibility="{x:Bind GlyphVisibility}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        FontWeight="SemiBold"
                        Style="{StaticResource ResonateBodyTextStyle}"
                        Text="{x:Bind Title}" />
                    <TextBlock Style="{StaticResource ResonateSecondaryTextStyle}" Text="{x:Bind Subtitle}" />
                </StackPanel>
                <controls:HoverReveal
                    Margin="0,126,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
                    <Button
                        Width="40"
                        Height="40"
                        Padding="0"
                        AutomationProperties.Name="{x:Bind PlayName}"
                        Click="{x:Bind Play}"
                        Content="&#xF5B0;"
                        CornerRadius="{ThemeResource ResonatePlayButtonCorner}"
                        FontFamily="{StaticResource ResonateIconFont}"
                        FontSize="16"
                        Style="{StaticResource ResonateAccentButtonStyle}"
                        ToolTipService.ToolTip="Play" />
                </controls:HoverReveal>
            </controls:HoverLift>
        </DataTemplate>

        <!-- A song played lately, with when; a click plays it. -->
        <DataTemplate x:Key="RecentCardTemplate" x:DataType="vm:RecentCard">
            <controls:HoverLift
                Width="{x:Bind CardSize}"
                Padding="0,0,0,8"
                ToolTipService.ToolTip="{x:Bind Tooltip}">
                <StackPanel Spacing="2">
                    <Grid
                        Width="{x:Bind CardSize}"
                        Height="{x:Bind CardSize}"
                        Margin="0,0,0,8"
                        Background="{x:Bind Cover.Background, Mode=OneWay}"
                        CornerRadius="{ThemeResource ResonateCornerMedium}">
                        <Image Source="{x:Bind Cover.Image}" Stretch="UniformToFill" />
                    </Grid>
                    <TextBlock
                        FontWeight="SemiBold"
                        Style="{StaticResource ResonateBodyTextStyle}"
                        Text="{x:Bind Title}" />
                    <TextBlock
                        helpers:SongLinks.To="Artists"
                        Style="{StaticResource ResonateSecondaryTextStyle}"
                        Text="{x:Bind Artists}" />
                    <TextBlock Style="{StaticResource ResonateCaptionTextStyle}" Text="{x:Bind Ago}" />
                </StackPanel>
                <controls:HoverReveal
                    Width="40"
                    Height="40"
                    Margin="{x:Bind PlayMargin}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{StaticResource ResonateAccentBrush}"
                    CornerRadius="{ThemeResource ResonatePlayButtonCorner}"
                    IsHitTestVisible="False">
                    <FontIcon
                        FontFamily="{StaticResource ResonateIconFont}"
                        FontSize="16"
                        Foreground="{StaticResource ResonateOnAccentBrush}"
                        Glyph="&#xF5B0;" />
                </controls:HoverReveal>
            </controls:HoverLift>
        </DataTemplate>

        <!--
          Rediscover (a built-in plugin, HomePage.Rediscover.cs), like the other
          rows' cards: the cover, a label saying why it is here, the title, the
          artists and a note. Songs show a play button under the pointer; albums open.
        -->
        <DataTemplate x:Key="RediscoverCardTemplate" x:DataType="vm:RediscoverTile">
            <controls:HoverLift
                Width="176"
                Padding="0,0,0,10"
                ToolTipService.ToolTip="{x:Bind Tooltip}">
                <StackPanel Spacing="2">
                    <Grid
                        Width="176"
                        Height="176"
                        Margin="0,0,0,8"
                        Background="{x:Bind Cover.Background, Mode=OneWay}"
                        CornerRadius="{ThemeResource ResonateCornerLarge}">
                        <Image Source="{x:Bind Cover.Image}" Stretch="UniformToFill" />
                    </Grid>
                    <TextBlock
                        Margin="0,0,0,2"
                        Foreground="{StaticResource ResonateAccentBrush}"
                        Style="{StaticResource ResonateEyebrowTextStyle}"
                        Text="{x:Bind Label}" />
                    <TextBlock
                        FontWeight="SemiBold"
                        MaxLines="1"
                        Style="{StaticResource ResonateBodyTextStyle}"
                        Text="{x:Bind Title}"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        MaxLines="1"
                        Style="{StaticResource ResonateSecondaryTextStyle}"
                        Text="{x:Bind Subtitle}"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        MaxLines="1"
                        Style="{StaticResource ResonateCaptionTextStyle}"
                        Text="{x:Bind Note}"
                        TextWrapping="NoWrap" />
                </StackPanel>
                <controls:HoverReveal
                    Width="40"
                    Height="40"
                    Margin="0,128,8,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{StaticResource ResonateAccentBrush}"
                    CornerRadius="{ThemeResource ResonatePlayButtonCorner}"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind PlayVisibility}">
                    <FontIcon
                        FontFamily="{StaticResource ResonateIconFont}"
                        FontSize="16"
                        Foreground="{StaticResource ResonateOnAccentBrush}"
                        Glyph="&#xF5B0;" />
                </controls:HoverReveal>
            </controls:HoverLift>
        </DataTemplate>

        <!-- One of the top artists on Spotify: a round portrait (initials until it loads) with its rank. A click opens the artist. -->
        <DataTemplate x:Key="TopArtistTemplate" x:DataType="vm:TopArtistRow">
            <controls:HoverLift Width="112" Padding="4,0,4,10">
                <StackPanel Spacing="10">
                    <Grid Width="104" Height="104">
                        <Grid Background="{x:Bind PlaceholderBrush}" CornerRadius="52">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{ThemeResource ResonateDisplayFont}"
                                FontSize="{ThemeResource ResonateFontSize32}"
                                FontWeight="SemiBold"
                                Foreground="{x:Bind InitialsBrush}"
                                Text="{x:Bind Initials}" />
                            <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
                        </Grid>
                        <Border
                            Height="28"
                            MinWidth="28"
                            Padding="8,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="{StaticResource ResonateAccentBrush}"
                            CornerRadius="14"
                            Visibility="{x:Bind FirstVisibility}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{ThemeResource ResonateTextFont}"
                                FontSize="{ThemeResource ResonateFontSize12}"
                                FontWeight="Bold"
                                Foreground="{StaticResource ResonateOnAccentBrush}"
                                Text="{x:Bind Rank}" />
                        </Border>
                        <Border
                            Height="28"
                            MinWidth="28"
                            Padding="8,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="{StaticResource ResonateSurfaceBrush}"
                            BorderBrush="{StaticResource ResonateBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Visibility="{x:Bind OtherVisibility}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{ThemeResource ResonateTextFont}"
                                FontSize="{ThemeResource ResonateFontSize12}"
                                FontWeight="Bold"
                                Foreground="{StaticResource ResonateTextPrimaryBrush}"
                                Text="{x:Bind Rank}" />
                        </Border>
                    </Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontWeight="SemiBold"
                        Style="{StaticResource ResonateBodyTextStyle}"
                        Text="{x:Bind Name}"
                        TextAlignment="Center" />
                </StackPanel>
            </controls:HoverLift>
        </DataTemplate>

        <!-- One of the top songs on Spotify: a large rank, the cover, title and artists. A click plays the list from it. -->
        <DataTemplate x:Key="TopSongTemplate" x:DataType="vm:TopSongRow">
            <Grid
                Height="{x:Bind RowHeight}"
                Padding="4,0,8,0"
                Background="{StaticResource ResonateTransparentBrush}"
                ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{x:Bind CoverColumn}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Width="{ThemeResource ResonateRankWidth}"
                    VerticalAlignment="Center"
                    FontFamily="{ThemeResource ResonateDisplayFont}"
                    FontSize="{ThemeResource ResonateFontSize26}"
                    FontWeight="Bold"
                    Foreground="{StaticResource ResonateAccentBrush}"
                    Text="{x:Bind Rank}"
                    TextAlignment="Right"
                    Visibility="{x:Bind FirstVisibility}" />
                <TextBlock
                    Width="{ThemeResource ResonateRankWidth}"
                    VerticalAlignment="Center"
                    FontFamily="{ThemeResource ResonateDisplayFont}"
                    FontSize="{ThemeResource ResonateFontSize26}"
                    FontWeight="Bold"
                    Foreground="{StaticResource ResonateTextTertiaryBrush}"
                    Text="{x:Bind Rank}"
                    TextAlignment="Right"
                    Visibility="{x:Bind OtherVisibility}" />
                <Grid
                    Grid.Column="1"
                    Width="{x:Bind CoverSize}"
                    Height="{x:Bind CoverSize}"
                    Background="{x:Bind Cover.Background, Mode=OneWay}"
                    CornerRadius="{ThemeResource ResonateCornerSmall}">
                    <Image Source="{x:Bind Cover.Image}" Stretch="UniformToFill" />
                </Grid>
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        FontWeight="SemiBold"
                        Style="{StaticResource ResonateBodyTextStyle}"
                        Text="{x:Bind Title}" />
                    <TextBlock
                        helpers:SongLinks.To="Artists"
                        Style="{StaticResource ResonateCaptionTextStyle}"
                        Text="{x:Bind Artists}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer x:Name="Scroller">
        <StackPanel
            x:Name="Body"
            Padding="28,28,28,28"
            SizeChanged="OnBodySizeChanged"
            Spacing="40">
            <!-- The Home stage, a built-in plugin (HomePage.Stage.cs): shown only while it is on. -->
            <Border x:Name="StageSlot" Visibility="Collapsed" />

            <StackPanel Spacing="12">
                <!--
                  The greeting with what plays (or played last), on a wash of
                  that song's cover colours; the stats beside it on a wide
                  window, under it otherwise (see Fit).
                -->
                <Grid
                    x:Name="Overview"
                    ColumnSpacing="16"
                    RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        x:Name="Hero"
                        Grid.ColumnSpan="2"
                        MinHeight="220"
                        Background="{StaticResource ResonateSurfaceHoverBrush}"
                        BorderBrush="{StaticResource ResonateBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ResonateCornerLarge}">
                        <!-- A brush, not an Image: an Image would make the card as tall as the square picture. -->
                        <Border
                            x:Name="HeroWash"
                            CornerRadius="{ThemeResource ResonateCornerLarge}"
                            IsHitTestVisible="False"
                            Opacity="0">
                            <Border.Background>
                                <ImageBrush x:Name="HeroWashBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border
                            x:Name="HeroScrim"
                            CornerRadius="{ThemeResource ResonateCornerLarge}"
                            IsHitTestVisible="False" />
                        <Grid
                            x:Name="HeroContent"
                            Padding="32,26,26,26"
                            ColumnSpacing="32"
                            RowSpacing="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel
                                x:Name="HeroGreeting"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        x:Name="DayGlyph"
                                        FontFamily="{StaticResource ResonateIconFont}"
                                        FontSize="14"
                                        Foreground="{StaticResource ResonateAccentBrush}"
                                        Glyph="&#xE706;" />
                                    <TextBlock
                                        x:Name="DateText"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ResonateEyebrowTextStyle}" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="GreetingText"
                                    FontSize="{ThemeResource ResonateFontSize46}"
                                    FontWeight="Bold"
                                    Style="{StaticResource ResonateDisplayTextStyle}"
                                    Text="Home" />
                                <TextBlock
                                    x:Name="TodayText"
                                    FontSize="{ThemeResource ResonateFontSize15}"
                                    Style="{StaticResource ResonateSecondaryTextStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- What plays now, or what played last while nothing is loaded. -->
                            <Border
                                x:Name="NowPlaying"
                                Grid.Column="1"
                                Padding="14"
                                VerticalAlignment="Center"
                                BorderBrush="{StaticResource ResonateBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ResonateCornerLarge}"
                                Visibility="Collapsed">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        Width="104"
                                        Height="104"
                                        VerticalAlignment="Center">
                                        <controls:Elevation CornerRadius="{ThemeResource ResonateCornerMedium}" Level="Item" />
                                        <Grid x:Name="NowCover" CornerRadius="{ThemeResource ResonateCornerMedium}">
                                            <Image x:Name="NowImage" Stretch="UniformToFill" />
                                        </Grid>
                                    </Grid>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock
                                            x:Name="NowLabel"
                                            Style="{StaticResource ResonateEyebrowTextStyle}"
                                            Text="NOW PLAYING" />
                                        <TextBlock
                                            x:Name="NowTitle"
                                            Margin="0,4,0,0"
                                            FontSize="{ThemeResource ResonateFontSize18}"
                                            Style="{StaticResource ResonateTitleTextStyle}" />
                                        <TextBlock x:Name="NowArtists" Style="{StaticResource ResonateSecondaryTextStyle}" />
                                        <TextBlock x:Name="NowSource" Style="{StaticResource ResonateCaptionTextStyle}" />
                                        <Button
                                            x:Name="HeroPlayButton"
                                            Margin="0,10,0,0"
                                            Padding="16,6"
                                            Click="OnHeroPlayClick"
                                            Style="{StaticResource ResonateAccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon
                                                    x:Name="HeroPlayGlyph"
                                                    FontFamily="{StaticResource ResonateIconFont}"
                                                    FontSize="12"
                                                    Glyph="&#xF5B0;" />
                                                <TextBlock x:Name="HeroPlayText" Text="Resume" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Shown once the stored history is read (a moment after the page), so no empty numbers flash first. -->
                    <Grid
                        x:Name="StatsGrid"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        ColumnSpacing="16"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ContentPresenter
                            x:Name="DayStats"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            ContentTemplate="{StaticResource StatCardTemplate}" />
                        <ContentPresenter
                            x:Name="WeekStats"
                            Grid.Column="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            ContentTemplate="{StaticResource StatCardTemplate}" />
                    </Grid>
                </Grid>
                <Border
                    x:Name="PermissionNote"
                    Padding="16,12"
                    Background="{StaticResource ResonateSurfaceHoverBrush}"
                    CornerRadius="{ThemeResource ResonateCornerMedium}"
                    Visibility="Collapsed">
                    <TextBlock
                        Style="{StaticResource ResonateSecondaryTextStyle}"
                        Text="Your listening stats and mixes need a permission your Spotify sign-in predates. In Settings, sign out, then sign in again."
                        TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <StackPanel
                x:Name="Sections"
                Spacing="40"
                Visibility="Collapsed">
                <!-- Made for you: the daily mixes and On repeat, as many as fit in a row ("Show all" for the rest). -->
                <StackPanel x:Name="MixesSection" Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource ResonateSectionTextStyle}" Text="Made for you" />
                        </StackPanel>
                        <Button
                            x:Name="MixesMoreButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="OnMixesMoreClick"
                            Content="Show all"
                            Style="{StaticResource ResonateSubtleButtonStyle}"
                            Visibility="Collapsed" />
                    </Grid>
                    <TextBlock
                        x:Name="MixesNote"
                        Style="{StaticResource ResonateSecondaryTextStyle}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <GridView
                        x:Name="MixGrid"
                        Margin="-4,0,0,0"
                        Padding="4,6,0,0"
                        IsItemClickEnabled="True"
                        ItemClick="OnMixClick"
                        ItemTemplate="{StaticResource MixCardTemplate}"
                        ItemsSource="{x:Bind Mixes}"
                        SelectionMode="None" />
                </StackPanel>

                <!-- Rediscover, a built-in plugin (HomePage.Rediscover.cs): shown only while it is on and has cards. -->
                <StackPanel
                    x:Name="RediscoverSection"
                    Spacing="12"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource ResonateSectionTextStyle}"
                            Text="Rediscover" />
                        <Button
                            x:Name="RediscoverMoreButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="OnRediscoverMoreClick"
                            Content="Show all"
                            Style="{StaticResource ResonateSubtleButtonStyle}"
                            Visibility="Collapsed" />
                    </Grid>
                    <GridView
                        x:Name="RediscoverGrid"
                        Margin="-4,0,0,0"
                        Padding="4,6,0,0"
                        IsItemClickEnabled="True"
                        ItemClick="OnRediscoverClick"
                        ItemTemplate="{StaticResource RediscoverCardTemplate}"
                        ItemsSource="{x:Bind Rediscovered}"
                        SelectionMode="None" />
                </StackPanel>

                <!-- Spotify's own top artists and songs, over the time range picked on the right. -->
                <StackPanel x:Name="TopSection" Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource ResonateSectionTextStyle}" Text="Your top on Spotify" />
                        </StackPanel>
                        <SelectorBar
                            x:Name="TopRangeBar"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            SelectionChanged="OnTopRangeChanged">
                            <SelectorBarItem x:Name="ShortTermItem" Text="4 weeks" />
                            <SelectorBarItem x:Name="MediumTermItem" Text="6 months" />
                            <SelectorBarItem x:Name="LongTermItem" Text="1 year" />
                        </SelectorBar>
                    </Grid>
                    <TextBlock
                        x:Name="TopNote"
                        Style="{StaticResource ResonateSecondaryTextStyle}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <StackPanel x:Name="TopLists" Spacing="12">
                        <TextBlock Style="{StaticResource ResonateEyebrowTextStyle}" Text="TOP ARTISTS" />
                        <GridView
                            x:Name="TopArtistList"
                            Margin="-4,0,0,0"
                            Padding="0,6,0,0"
                            IsItemClickEnabled="True"
                            ItemClick="OnTopArtistClick"
                            ItemTemplate="{StaticResource TopArtistTemplate}"
                            ItemsSource="{x:Bind TopArtists}"
                            SelectionMode="None" />
                        <Border
                            x:Name="TopSongsCard"
                            Padding="8,14,8,8"
                            Background="{StaticResource ResonateSurfaceHoverBrush}"
                            BorderBrush="{StaticResource ResonateBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ResonateCornerLarge}">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    Margin="16,0"
                                    Style="{StaticResource ResonateEyebrowTextStyle}"
                                    Text="TOP SONGS" />
                                <!-- One list, or two side by side (1 to 5 and 6 to 10) on a wide window. -->
                                <Grid x:Name="TopSongsGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <ListView
                                        x:Name="TopSongList"
                                        ContextRequested="OnTopSongContextRequested"
                                        IsItemClickEnabled="True"
                                        ItemClick="OnTopSongClick"
                                        ItemTemplate="{StaticResource TopSongTemplate}"
                                        ItemsSource="{x:Bind TopSongs}"
                                        SelectionMode="None" />
                                    <ListView
                                        x:Name="TopSongListMore"
                                        Grid.Column="1"
                                        ContextRequested="OnTopSongMoreContextRequested"
                                        IsItemClickEnabled="True"
                                        ItemClick="OnTopSongClick"
                                        ItemTemplate="{StaticResource TopSongTemplate}"
                                        ItemsSource="{x:Bind TopSongsMore}"
                                        SelectionMode="None"
                                        Visibility="Collapsed" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Button
                        x:Name="TopMoreButton"
                        HorizontalAlignment="Left"
                        Click="OnTopMoreClick"
                        Content="Show top 10"
                        Style="{StaticResource ResonateSubtleButtonStyle}" />
                </StackPanel>

                <!-- The songs played lately, as many as fit in a row ("Show all" for the rest). -->
                <StackPanel x:Name="RecentSection" Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource ResonateSectionTextStyle}"
                            Text="Recently played" />
                        <Button
                            x:Name="RecentMoreButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="OnRecentMoreClick"
                            Content="Show all"
                            Style="{StaticResource ResonateSubtleButtonStyle}"
                            Visibility="Collapsed" />
                    </Grid>
                    <TextBlock
                        x:Name="RecentNote"
                        Style="{StaticResource ResonateSecondaryTextStyle}"
                        Text="Songs you play appear here."
                        Visibility="Collapsed" />
                    <GridView
                        x:Name="RecentGrid"
                        Margin="-4,0,0,0"
                        Padding="4,6,0,0"
                        ContextRequested="OnRecentContextRequested"
                        IsItemClickEnabled="True"
                        ItemClick="OnRecentClick"
                        ItemTemplate="{StaticResource RecentCardTemplate}"
                        ItemsSource="{x:Bind Recent}"
                        SelectionMode="None" />
                </StackPanel>
            </StackPanel>
            <Border x:Name="PlayerSpace" Height="0" />
        </StackPanel>
    </ScrollViewer>
</Page>
