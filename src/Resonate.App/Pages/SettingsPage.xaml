<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Resonate.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource ResonateTransparentBrush}">

    <ScrollViewer>
        <StackPanel
            MaxWidth="720"
            Padding="36,36,36,48"
            HorizontalAlignment="Left"
            Spacing="28">
            <TextBlock
                FontSize="32"
                Style="{StaticResource ResonateDisplayTextStyle}"
                Text="Settings" />

            <!-- Look -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource ResonateTitleTextStyle}" Text="Look" />
                <TextBlock
                    Style="{StaticResource ResonateSecondaryTextStyle}"
                    Text="Pick a theme. It changes everything at once; more themes and your own colours come later."
                    TextWrapping="Wrap" />
                <StackPanel
                    x:Name="ThemeChoices"
                    Orientation="Horizontal"
                    Spacing="12" />
            </StackPanel>

            <!-- Account -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource ResonateTitleTextStyle}" Text="Spotify account" />
                <TextBlock
                    x:Name="AccountText"
                    Style="{StaticResource ResonateSecondaryTextStyle}"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="SignOutButton"
                    Click="OnSignOutClick"
                    Content="Sign out"
                    Style="{StaticResource ResonateSubtleButtonStyle}" />
            </StackPanel>

            <!-- Updates -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource ResonateTitleTextStyle}" Text="Updates" />
                <TextBlock
                    x:Name="VersionText"
                    Style="{StaticResource ResonateSecondaryTextStyle}"
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        x:Name="CheckUpdatesButton"
                        Click="OnCheckUpdatesClick"
                        Content="Check for updates"
                        Style="{StaticResource ResonateSubtleButtonStyle}" />
                    <Button
                        x:Name="RestartButton"
                        Click="OnRestartClick"
                        Content="Restart to update"
                        Style="{StaticResource ResonateAccentButtonStyle}"
                        Visibility="Collapsed" />
                </StackPanel>
                <TextBlock
                    x:Name="UpdateStatusText"
                    Style="{StaticResource ResonateCaptionTextStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- About -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource ResonateTitleTextStyle}" Text="About" />
                <TextBlock
                    x:Name="StartupText"
                    Style="{StaticResource ResonateSecondaryTextStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource ResonateSecondaryTextStyle}"
                    Text="Resonate is an independent app for Spotify and is not affiliated with or endorsed by Spotify. Music, cover art and song details come from Spotify, and every song plays in the Spotify app."
                    TextWrapping="Wrap" />
                <HyperlinkButton
                    Padding="0"
                    Content="Spotify"
                    NavigateUri="https://www.spotify.com" />
                <HyperlinkButton
                    Padding="0"
                    Content="Resonate on GitHub"
                    NavigateUri="https://github.com/livexibot/Resonate" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
