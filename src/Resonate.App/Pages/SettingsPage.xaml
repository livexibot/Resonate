<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Resonate.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Resonate.App.Controls"
    Background="{StaticResource ResonateTransparentBrush}">

    <ScrollViewer>
        <StackPanel
            MaxWidth="760"
            Padding="36,36,36,48"
            HorizontalAlignment="Left"
            Spacing="28">
            <TextBlock
                FontSize="32"
                Style="{StaticResource ResonateDisplayTextStyle}"
                Text="Settings" />

            <!-- Look: presets, your own looks and the customizer -->
            <controls:ThemeStudio x:Name="Studio" />

            <!-- Playback and the Spotify app -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource ResonateTitleTextStyle}" Text="Playback" />
                <TextBlock
                    Style="{StaticResource ResonateSecondaryTextStyle}"
                    Text="How Resonate talks to Spotify."
                    TextWrapping="Wrap" />
                <RadioButtons x:Name="ChannelChoice" SelectionChanged="OnChannelChanged">
                    <RadioButton Content="Windows' media controls, with the Web API as backup (fastest; plays in the Spotify app on this computer)" />
                    <RadioButton Content="Spotify Web API only (every control goes through Spotify's servers; Resonate leaves the Spotify app alone)" />
                </RadioButtons>
                <TextBlock
                    x:Name="WebApiOnlyNote"
                    Style="{StaticResource ResonateCaptionTextStyle}"
                    Text="Resonate never starts, hides or reads the Spotify app in this mode. Music plays on a Spotify device you have open (this computer's Spotify app, your phone, a speaker or open.spotify.com): pick it with the devices button next to the volume. Lossless depends on that device. The media keys, the equalizer for Spotify's songs and starting DJ need the Spotify app, so they work only with Windows' media controls."
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <StackPanel x:Name="SpotifyAppOptions" Spacing="12">
                    <ToggleSwitch
                        x:Name="KeepHiddenSwitch"
                        Header="Keep the Spotify app hidden"
                        OffContent="Off: Spotify stays on the taskbar, minimised"
                        OnContent="On: no taskbar button; it shows only while you use it"
                        Toggled="OnKeepHiddenToggled" />
                    <ToggleSwitch
                        x:Name="SaveResourcesSwitch"
                        Header="Let the hidden Spotify app use less power and memory"
                        OffContent="Off"
                        OnContent="On: only the parts that draw its window slow down; playback is untouched"
                        Toggled="OnSaveResourcesToggled" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            Click="OnShowSpotifyClick"
                            Content="Show the Spotify app"
                            Style="{StaticResource ResonateSubtleButtonStyle}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource ResonateCaptionTextStyle}"
                            Text="For example to sign in to it or set Lossless. It hides again when you switch away."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Equalizer: the Spotify app's own, and the same setting for local files -->
            <controls:EqualizerPanel />

            <!-- Local Files -->
            <controls:LocalFoldersPanel />

            <!-- Plugins: optional extras, downloaded only when turned on (built in code, see PluginsPanel.cs) -->
            <StackPanel x:Name="PluginsHost" />

            <!-- Account -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource ResonateTitleTextStyle}" Text="Spotify account" />
                <TextBlock
                    x:Name="AccountText"
                    Style="{StaticResource ResonateSecondaryTextStyle}"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="SignOutButton"
                    Click="OnSignOutClick"
                    Content="Sign out"
                    Style="{StaticResource ResonateSubtleButtonStyle}" />
            </StackPanel>

            <!-- Updates -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource ResonateTitleTextStyle}" Text="Updates" />
                <TextBlock
                    x:Name="VersionText"
                    Style="{StaticResource ResonateSecondaryTextStyle}"
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        x:Name="CheckUpdatesButton"
                        Click="OnCheckUpdatesClick"
                        Content="Check for updates"
                        Style="{StaticResource ResonateSubtleButtonStyle}" />
                    <Button
                        x:Name="RestartButton"
                        Click="OnRestartClick"
                        Content="Restart to update"
                        Style="{StaticResource ResonateAccentButtonStyle}"
                        Visibility="Collapsed" />
                </StackPanel>
                <TextBlock
                    x:Name="UpdateStatusText"
                    Style="{StaticResource ResonateCaptionTextStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- About -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource ResonateTitleTextStyle}" Text="About" />
                <TextBlock
                    x:Name="StartupText"
                    Style="{StaticResource ResonateSecondaryTextStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource ResonateSecondaryTextStyle}"
                    Text="Resonate is an independent app for Spotify and is not affiliated with or endorsed by Spotify. Music, cover art and song details come from Spotify, and every Spotify song plays in the Spotify app."
                    TextWrapping="Wrap" />
                <HyperlinkButton
                    Padding="0"
                    Content="Spotify"
                    NavigateUri="https://www.spotify.com" />
                <HyperlinkButton
                    Padding="0"
                    Content="Resonate on GitHub"
                    NavigateUri="https://github.com/livexibot/Resonate" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
