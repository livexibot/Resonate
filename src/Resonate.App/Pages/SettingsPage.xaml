<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Resonate.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Resonate.App.Controls"
    Background="{StaticResource ResonateTransparentBrush}">

    <!-- Shown in the Settings pane on the right of the window (see Controls/SettingsPane). -->
    <ScrollViewer>
        <StackPanel Padding="24,8,24,40" Spacing="28">
            <!-- Look: presets, your own looks and the customizer -->
            <controls:ThemeStudio x:Name="Studio" />

            <!-- Playback and the Spotify app -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource ResonateTitleTextStyle}" Text="Playback" />
                <RadioButtons x:Name="ChannelChoice" SelectionChanged="OnChannelChanged">
                    <RadioButton Content="Windows media controls (fastest)" />
                    <RadioButton Content="Spotify Web API only" />
                </RadioButtons>

                <ToggleSwitch
                    x:Name="KeepHiddenSwitch"
                    Header="Keep the Spotify app hidden"
                    OffContent="Off"
                    OnContent="On"
                    Toggled="OnKeepHiddenToggled" />
                <ToggleSwitch
                    x:Name="SaveResourcesSwitch"
                    Header="Save power while Spotify is hidden"
                    OffContent="Off"
                    OnContent="On"
                    Toggled="OnSaveResourcesToggled" />
                <Button
                    Click="OnShowSpotifyClick"
                    Content="Show the Spotify app"
                    Style="{StaticResource ResonateSubtleButtonStyle}"
                    ToolTipService.ToolTip="It hides again when you switch away" />
            </StackPanel>

            <!-- Equalizer: the Spotify app's own, and the same setting for local files -->
            <controls:EqualizerPanel />

            <!-- Local Files -->
            <controls:LocalFoldersPanel />

            <!-- Plugins: optional extras, downloaded only when turned on (built in code, see PluginsPanel.cs) -->
            <StackPanel x:Name="PluginsHost" />

            <!-- Account -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource ResonateTitleTextStyle}" Text="Spotify account" />
                <TextBlock
                    x:Name="AccountText"
                    Style="{StaticResource ResonateSecondaryTextStyle}"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="SignOutButton"
                    Click="OnSignOutClick"
                    Content="Sign out"
                    Style="{StaticResource ResonateSubtleButtonStyle}" />
            </StackPanel>

            <!-- Updates -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource ResonateTitleTextStyle}" Text="Updates" />
                <TextBlock
                    x:Name="VersionText"
                    Style="{StaticResource ResonateSecondaryTextStyle}"
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        x:Name="CheckUpdatesButton"
                        Click="OnCheckUpdatesClick"
                        Content="Check for updates"
                        Style="{StaticResource ResonateSubtleButtonStyle}" />
                    <Button
                        x:Name="RestartButton"
                        Click="OnRestartClick"
                        Content="Restart to update"
                        Style="{StaticResource ResonateAccentButtonStyle}"
                        Visibility="Collapsed" />
                </StackPanel>
                <!-- While a new version downloads (see UpdateService.Progress) -->
                <StackPanel
                    x:Name="UpdateProgressPanel"
                    Spacing="6"
                    Visibility="Collapsed">
                    <ProgressBar x:Name="UpdateProgressBar" Maximum="1" />
                    <TextBlock
                        x:Name="UpdateProgressText"
                        Style="{StaticResource ResonateCaptionTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock
                    x:Name="UpdateStatusText"
                    Style="{StaticResource ResonateCaptionTextStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- About -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource ResonateTitleTextStyle}" Text="About" />
                <TextBlock
                    x:Name="StartupText"
                    Style="{StaticResource ResonateSecondaryTextStyle}"
                    TextWrapping="Wrap" />
                <!-- Spotify's terms ask apps to credit Spotify for its content; this is that credit. -->
                <TextBlock
                    Style="{StaticResource ResonateSecondaryTextStyle}"
                    Text="Songs, covers and details come from Spotify. Resonate is not affiliated with Spotify."
                    TextWrapping="Wrap" />
                <HyperlinkButton
                    Padding="0"
                    Content="Spotify"
                    NavigateUri="https://www.spotify.com" />
                <HyperlinkButton
                    Padding="0"
                    Content="Resonate on GitHub"
                    NavigateUri="https://github.com/livexibot/Resonate" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
