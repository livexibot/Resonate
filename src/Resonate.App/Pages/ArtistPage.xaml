<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Resonate.App.Pages.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Resonate.App.ViewModels"
    Background="{StaticResource ResonateTransparentBrush}">

    <Page.Resources>
        <DataTemplate x:Key="AlbumCardTemplate" x:DataType="vm:CardItem">
            <StackPanel
                Width="168"
                Padding="4,4,4,8"
                Spacing="8">
                <Grid
                    Width="160"
                    Height="160"
                    Background="{x:Bind PlaceholderBrush}"
                    CornerRadius="{ThemeResource ResonateCornerMedium}">
                    <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
                </Grid>
                <TextBlock
                    FontWeight="SemiBold"
                    Style="{StaticResource ResonateBodyTextStyle}"
                    Text="{x:Bind Title}" />
                <TextBlock Style="{StaticResource ResonateSecondaryTextStyle}" Text="{x:Bind Subtitle}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="28,36,28,28" Spacing="28">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="184" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        x:Name="PortraitFrame"
                        Width="184"
                        Height="184"
                        CornerRadius="92">
                        <Image x:Name="PortraitImage" Stretch="UniformToFill" />
                    </Grid>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Spacing="8">
                        <TextBlock
                            CharacterSpacing="60"
                            Style="{StaticResource ResonateCaptionTextStyle}"
                            Text="ARTIST" />
                        <TextBlock
                            x:Name="NameText"
                            Style="{StaticResource ResonateDisplayTextStyle}"
                            Text=" " />
                        <TextBlock
                            x:Name="GenresText"
                            Style="{StaticResource ResonateCaptionTextStyle}"
                            Visibility="Collapsed" />
                        <StackPanel
                            Margin="0,10,0,0"
                            Orientation="Horizontal"
                            Spacing="12">
                            <Button Click="OnPlayClick" Style="{StaticResource ResonateAccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontFamily="{StaticResource ResonateIconFont}"
                                        FontSize="14"
                                        Glyph="&#xE768;" />
                                    <TextBlock Text="Play" />
                                </StackPanel>
                            </Button>
                            <Button
                                Click="OnLikedSongsClick"
                                Content="Liked songs by this artist"
                                Style="{StaticResource ResonateSubtleButtonStyle}" />
                            <Button
                                Click="OnOpenInSpotifyClick"
                                Content="Open in Spotify"
                                Style="{StaticResource ResonateSubtleButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="AlbumsSection" Spacing="6" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource ResonateTitleTextStyle}" Text="Albums" />
                    <GridView
                        IsItemClickEnabled="True"
                        ItemClick="OnAlbumClick"
                        ItemTemplate="{StaticResource AlbumCardTemplate}"
                        ItemsSource="{x:Bind Albums}"
                        SelectionMode="None" />
                </StackPanel>

                <StackPanel x:Name="SinglesSection" Spacing="6" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource ResonateTitleTextStyle}" Text="Singles and EPs" />
                    <GridView
                        IsItemClickEnabled="True"
                        ItemClick="OnAlbumClick"
                        ItemTemplate="{StaticResource AlbumCardTemplate}"
                        ItemsSource="{x:Bind Singles}"
                        SelectionMode="None" />
                </StackPanel>

                <StackPanel x:Name="CompilationsSection" Spacing="6" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource ResonateTitleTextStyle}" Text="Compilations" />
                    <GridView
                        IsItemClickEnabled="True"
                        ItemClick="OnAlbumClick"
                        ItemTemplate="{StaticResource AlbumCardTemplate}"
                        ItemsSource="{x:Bind Compilations}"
                        SelectionMode="None" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            x:Name="LoadingRing"
            Width="36"
            Height="36"
            IsActive="False" />
    </Grid>
</Page>
