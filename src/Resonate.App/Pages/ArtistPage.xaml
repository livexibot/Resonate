<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Resonate.App.Pages.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Resonate.App.Controls"
    xmlns:vm="using:Resonate.App.ViewModels"
    Background="{StaticResource ResonateTransparentBrush}">

    <Page.Resources>
        <DataTemplate x:Key="AlbumCardTemplate" x:DataType="vm:CardItem">
            <StackPanel
                Width="168"
                Padding="4,4,4,8"
                Spacing="8">
                <Grid
                    Width="160"
                    Height="160"
                    Background="{x:Bind PlaceholderBrush}"
                    CornerRadius="{ThemeResource ResonateCornerMedium}">
                    <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
                </Grid>
                <TextBlock
                    FontWeight="SemiBold"
                    Style="{StaticResource ResonateBodyTextStyle}"
                    Text="{x:Bind Title}" />
                <TextBlock Style="{StaticResource ResonateSecondaryTextStyle}" Text="{x:Bind Subtitle}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="{StaticResource ResonatePagePadding}" Spacing="{StaticResource ResonateSectionSpacing}">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="232" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--
                      The picture's colour, fading towards the releases (Helpers/CoverHero.cs).
                      It reaches past the page's padding to the panel's edges.
                    -->
                    <Border
                        x:Name="Hero"
                        Grid.ColumnSpan="2"
                        Margin="-32,-32,-32,-36"
                        CornerRadius="{ThemeResource ResonateCornerLarge}"
                        IsHitTestVisible="False" />
                    <controls:Elevation
                        Width="232"
                        Height="232"
                        CornerRadius="116"
                        Level="Item" />
                    <Grid
                        x:Name="PortraitFrame"
                        Width="232"
                        Height="232"
                        CornerRadius="116">
                        <Image x:Name="PortraitImage" Stretch="UniformToFill" />
                    </Grid>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Spacing="8">
                        <TextBlock Style="{StaticResource ResonateEyebrowTextStyle}" Text="ARTIST" />
                        <TextBlock
                            x:Name="NameText"
                            Style="{StaticResource ResonateDisplayTextStyle}"
                            Text=" " />
                        <TextBlock
                            x:Name="GenresText"
                            Style="{StaticResource ResonateCaptionTextStyle}"
                            Visibility="Collapsed" />
                        <StackPanel
                            Margin="0,10,0,0"
                            Orientation="Horizontal"
                            Spacing="12">
                            <Button Click="OnPlayClick" Style="{StaticResource ResonateAccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontFamily="{StaticResource ResonateIconFont}"
                                        FontSize="14"
                                        Glyph="&#xF5B0;" />
                                    <TextBlock Text="Play" />
                                </StackPanel>
                            </Button>
                            <Button
                                Click="OnLikedSongsClick"
                                Content="Liked songs by this artist"
                                Style="{StaticResource ResonateSubtleButtonStyle}" />
                            <Button
                                Click="OnOpenInSpotifyClick"
                                Content="Open in Spotify"
                                Style="{StaticResource ResonateSubtleButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel
                    x:Name="AlbumsSection"
                    Spacing="{StaticResource ResonateSectionHeaderSpacing}"
                    Visibility="Collapsed">
                    <TextBlock Style="{StaticResource ResonateSectionTextStyle}" Text="Albums" />
                    <GridView
                        IsItemClickEnabled="True"
                        ItemClick="OnAlbumClick"
                        ItemTemplate="{StaticResource AlbumCardTemplate}"
                        ItemsSource="{x:Bind Albums}"
                        SelectionMode="None" />
                </StackPanel>

                <StackPanel
                    x:Name="SinglesSection"
                    Spacing="{StaticResource ResonateSectionHeaderSpacing}"
                    Visibility="Collapsed">
                    <TextBlock Style="{StaticResource ResonateSectionTextStyle}" Text="Singles and EPs" />
                    <GridView
                        IsItemClickEnabled="True"
                        ItemClick="OnAlbumClick"
                        ItemTemplate="{StaticResource AlbumCardTemplate}"
                        ItemsSource="{x:Bind Singles}"
                        SelectionMode="None" />
                </StackPanel>

                <StackPanel
                    x:Name="CompilationsSection"
                    Spacing="{StaticResource ResonateSectionHeaderSpacing}"
                    Visibility="Collapsed">
                    <TextBlock Style="{StaticResource ResonateSectionTextStyle}" Text="Compilations" />
                    <GridView
                        IsItemClickEnabled="True"
                        ItemClick="OnAlbumClick"
                        ItemTemplate="{StaticResource AlbumCardTemplate}"
                        ItemsSource="{x:Bind Compilations}"
                        SelectionMode="None" />
                </StackPanel>

                <!-- Room for a player hovering over the page (see IPlayerInset). -->
                <Border x:Name="PlayerSpace" Height="0" />
            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            x:Name="LoadingRing"
            Width="36"
            Height="36"
            IsActive="False" />
    </Grid>
</Page>
