<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Resonate.App.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Resonate.App.ViewModels"
    Background="{StaticResource ResonateTransparentBrush}">

    <Page.Resources>
        <DataTemplate x:Key="CardTemplate" x:DataType="vm:CardItem">
            <StackPanel
                Width="168"
                Padding="4,4,4,8"
                Spacing="8">
                <Grid
                    Width="160"
                    Height="160"
                    Background="{x:Bind PlaceholderBrush}"
                    CornerRadius="{ThemeResource ResonateCornerMedium}">
                    <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
                </Grid>
                <TextBlock
                    FontWeight="SemiBold"
                    Style="{StaticResource ResonateBodyTextStyle}"
                    Text="{x:Bind Title}" />
                <TextBlock Style="{StaticResource ResonateSecondaryTextStyle}" Text="{x:Bind Subtitle}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="28,28,28,0" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="560" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="QueryBox"
                AutomationProperties.Name="Search"
                CornerRadius="22"
                FontSize="15"
                Padding="18,11,18,11"
                PlaceholderText="What do you want to listen to?"
                TextChanged="OnQueryChanged" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="0,0,0,28" Spacing="12">
                <TextBlock
                    x:Name="HintText"
                    Margin="0,8,0,0"
                    Style="{StaticResource ResonateSecondaryTextStyle}"
                    Text="Search for songs, albums and playlists. Double-click a song to play it." />

                <StackPanel x:Name="SongsSection" Spacing="6" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource ResonateTitleTextStyle}" Text="Songs" />
                    <ListView
                        x:Name="SongList"
                        DoubleTapped="OnSongDoubleTapped"
                        ItemsSource="{x:Bind Songs}"
                        KeyDown="OnSongListKeyDown"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrackRow">
                                <Grid Height="56" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="5*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        Width="40"
                                        Height="40"
                                        Background="{x:Bind PlaceholderBrush}"
                                        CornerRadius="{ThemeResource ResonateCornerSmall}">
                                        <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
                                    </Grid>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock
                                            Foreground="{x:Bind TitleBrush, Mode=OneWay}"
                                            Style="{StaticResource ResonateBodyTextStyle}"
                                            Text="{x:Bind Title}" />
                                        <TextBlock Style="{StaticResource ResonateSecondaryTextStyle}" Text="{x:Bind Artists}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ResonateSecondaryTextStyle}"
                                        Text="{x:Bind Album}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ResonateSecondaryTextStyle}"
                                        Text="{x:Bind Duration}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel x:Name="PlaylistsSection" Spacing="6" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource ResonateTitleTextStyle}" Text="Playlists" />
                    <GridView
                        IsItemClickEnabled="True"
                        ItemClick="OnPlaylistClick"
                        ItemTemplate="{StaticResource CardTemplate}"
                        ItemsSource="{x:Bind PlaylistCards}"
                        SelectionMode="None" />
                </StackPanel>

                <StackPanel x:Name="AlbumsSection" Spacing="6" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource ResonateTitleTextStyle}" Text="Albums" />
                    <GridView
                        IsItemClickEnabled="True"
                        ItemClick="OnAlbumClick"
                        ItemTemplate="{StaticResource CardTemplate}"
                        ItemsSource="{x:Bind AlbumCards}"
                        SelectionMode="None" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            x:Name="SearchingRing"
            Grid.Row="1"
            Width="32"
            Height="32"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            IsActive="False" />
    </Grid>
</Page>
