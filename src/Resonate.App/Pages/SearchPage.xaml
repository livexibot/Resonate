<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Resonate.App.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Resonate.App.Helpers"
    xmlns:vm="using:Resonate.App.ViewModels"
    Background="{StaticResource ResonateTransparentBrush}">

    <Page.Resources>
        <DataTemplate x:Key="CardTemplate" x:DataType="vm:CardItem">
            <StackPanel
                Width="168"
                Padding="4,4,4,8"
                Spacing="8">
                <Grid
                    Width="160"
                    Height="160"
                    Background="{x:Bind Cover.Background, Mode=OneWay}"
                    CornerRadius="{ThemeResource ResonateCornerMedium}">
                    <Image Source="{x:Bind Cover.Image}" Stretch="UniformToFill" />
                </Grid>
                <TextBlock
                    FontWeight="SemiBold"
                    Style="{StaticResource ResonateBodyTextStyle}"
                    Text="{x:Bind Title}" />
                <TextBlock Style="{StaticResource ResonateSecondaryTextStyle}" Text="{x:Bind Subtitle}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ArtistCardTemplate" x:DataType="vm:CardItem">
            <StackPanel
                Width="168"
                Padding="4,4,4,8"
                Spacing="8">
                <Grid
                    Width="160"
                    Height="160"
                    Background="{x:Bind Cover.Background, Mode=OneWay}"
                    CornerRadius="80">
                    <Image Source="{x:Bind Cover.Image}" Stretch="UniformToFill" />
                </Grid>
                <TextBlock
                    FontWeight="SemiBold"
                    Style="{StaticResource ResonateBodyTextStyle}"
                    Text="{x:Bind Title}"
                    TextAlignment="Center" />
                <TextBlock
                    Style="{StaticResource ResonateSecondaryTextStyle}"
                    Text="{x:Bind Subtitle}"
                    TextAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The box stays put; the results scroll under it, with the scroll bar at the panel's edge. -->
        <Grid Margin="32,32,32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="560" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="QueryBox"
                MinHeight="40"
                Padding="18,9,18,9"
                AutomationProperties.Name="Search"
                CornerRadius="{ThemeResource ResonateCornerInput}"
                FontSize="{ThemeResource ResonateFontSize15}"
                PlaceholderText="What do you want to listen to?"
                TextChanged="OnQueryChanged" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="{StaticResource ResonatePagePadding}" Spacing="{StaticResource ResonateSectionSpacing}">
                <TextBlock
                    x:Name="HintText"
                    Style="{StaticResource ResonateSecondaryTextStyle}"
                    Text="Search for songs, artists, albums and playlists. Double-click a song to play it." />

                <StackPanel
                    x:Name="SongsSection"
                    Spacing="{StaticResource ResonateSectionHeaderSpacing}"
                    Visibility="Collapsed">
                    <TextBlock Style="{StaticResource ResonateSectionTextStyle}" Text="Songs" />
                    <ListView
                        x:Name="SongList"
                        ContextRequested="OnSongContextRequested"
                        DoubleTapped="OnSongDoubleTapped"
                        ItemsSource="{x:Bind Songs}"
                        KeyDown="OnSongListKeyDown"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrackRow">
                                <Grid
                                    MinHeight="56"
                                    Background="{StaticResource ResonateTransparentBrush}"
                                    ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="5*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        Width="40"
                                        Height="40"
                                        Background="{x:Bind Cover.Background, Mode=OneWay}"
                                        CornerRadius="{ThemeResource ResonateCornerSmall}">
                                        <Image Source="{x:Bind Cover.Image}" Stretch="UniformToFill" />
                                    </Grid>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock
                                            Foreground="{x:Bind TitleBrush, Mode=OneWay}"
                                            Style="{StaticResource ResonateBodyTextStyle}"
                                            Text="{x:Bind Title}" />
                                        <TextBlock
                                            helpers:SongLinks.To="Artists"
                                            Style="{StaticResource ResonateSecondaryTextStyle}"
                                            Text="{x:Bind Artists}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        helpers:SongLinks.To="Album"
                                        Style="{StaticResource ResonateSecondaryTextStyle}"
                                        Text="{x:Bind Album}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ResonateSecondaryTextStyle}"
                                        Text="{x:Bind Duration}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel
                    x:Name="ArtistsSection"
                    Spacing="{StaticResource ResonateSectionHeaderSpacing}"
                    Visibility="Collapsed">
                    <TextBlock Style="{StaticResource ResonateSectionTextStyle}" Text="Artists" />
                    <GridView
                        IsItemClickEnabled="True"
                        ItemClick="OnArtistClick"
                        ItemTemplate="{StaticResource ArtistCardTemplate}"
                        ItemsSource="{x:Bind ArtistCards}"
                        SelectionMode="None" />
                </StackPanel>

                <StackPanel
                    x:Name="PlaylistsSection"
                    Spacing="{StaticResource ResonateSectionHeaderSpacing}"
                    Visibility="Collapsed">
                    <TextBlock Style="{StaticResource ResonateSectionTextStyle}" Text="Playlists" />
                    <GridView
                        IsItemClickEnabled="True"
                        ItemClick="OnPlaylistClick"
                        ItemTemplate="{StaticResource CardTemplate}"
                        ItemsSource="{x:Bind PlaylistCards}"
                        SelectionMode="None" />
                </StackPanel>

                <StackPanel
                    x:Name="AlbumsSection"
                    Spacing="{StaticResource ResonateSectionHeaderSpacing}"
                    Visibility="Collapsed">
                    <TextBlock Style="{StaticResource ResonateSectionTextStyle}" Text="Albums" />
                    <GridView
                        IsItemClickEnabled="True"
                        ItemClick="OnAlbumClick"
                        ItemTemplate="{StaticResource CardTemplate}"
                        ItemsSource="{x:Bind AlbumCards}"
                        SelectionMode="None" />
                </StackPanel>

                <!-- Room for a player hovering over the page (see IPlayerInset). -->
                <Border x:Name="PlayerSpace" Height="0" />
            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            x:Name="SearchingRing"
            Grid.Row="1"
            Width="32"
            Height="32"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            IsActive="False" />
    </Grid>
</Page>
