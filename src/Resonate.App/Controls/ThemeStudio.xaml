<?xml version="1.0" encoding="utf-8"?>
<!--
  The Themes tab of Settings: the presets, the user's own looks, the
  effects and a customizer for everything a look sets, each in a section
  that folds away. Changes show at once; see ThemeStudio.xaml.cs.
-->
<UserControl
    x:Class="Resonate.App.Controls.ThemeStudio"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Resonate.App.Controls">

    <UserControl.Resources>
        <Style x:Key="StudioSectionTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource ResonateTextFont}" />
            <Setter Property="FontSize" Value="{ThemeResource ResonateFontSize12}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="60" />
            <Setter Property="Foreground" Value="{StaticResource ResonateTextSecondaryBrush}" />
            <Setter Property="Margin" Value="2,10,0,2" />
        </Style>
        <Style x:Key="StudioValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource ResonateTextFont}" />
            <Setter Property="FontSize" Value="{ThemeResource ResonateFontSize13}" />
            <Setter Property="Foreground" Value="{StaticResource ResonateTextSecondaryBrush}" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StudioSliderStyle" TargetType="Slider">
            <Setter Property="Width" Value="190" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsThumbToolTipEnabled" Value="False" />
        </Style>
        <Style x:Key="StudioComboStyle" TargetType="ComboBox">
            <Setter Property="MinWidth" Value="190" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="20">
        <!-- The presets, dark ones on the left and light ones on the right (the page scrolls, not the grids) -->
        <controls:SettingsGroup Header="Presets">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <GridView
                    x:Name="DarkPresetGrid"
                    AutomationProperties.Name="Dark presets"
                    IsItemClickEnabled="True"
                    ItemClick="OnLookClick"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionMode="Single" />
                <GridView
                    x:Name="LightPresetGrid"
                    Grid.Column="1"
                    AutomationProperties.Name="Light presets"
                    IsItemClickEnabled="True"
                    ItemClick="OnLookClick"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionMode="Single" />
            </Grid>
        </controls:SettingsGroup>

        <!-- The user's own looks, each with a button to delete it -->
        <controls:SettingsGroup x:Name="YourLooksPanel" Header="Your looks">
            <GridView
                x:Name="YourLooksGrid"
                AutomationProperties.Name="Your looks"
                IsItemClickEnabled="True"
                ItemClick="OnLookClick"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollMode="Disabled"
                SelectionMode="Single" />
        </controls:SettingsGroup>

        <!-- Effects: the user's own choices, kept whatever look is in use (not part of a look) -->
        <controls:SettingsGroup Header="Effects">
            <StackPanel Spacing="6">
                <controls:SettingRow Header="Switching animation">
                    <ComboBox
                        x:Name="TransitionChoice"
                        MinWidth="170"
                        AutomationProperties.Name="Switching animation"
                        SelectionChanged="OnTransitionChanged">
                        <ComboBoxItem Content="Morph" Tag="Morph" />
                        <ComboBoxItem Content="Cross-fade" Tag="Fade" />
                        <ComboBoxItem Content="Spread from the middle" Tag="Grow" />
                        <ComboBoxItem Content="Ripple from the click" Tag="Ripple" />
                        <ComboBoxItem Content="Split apart" Tag="Split" />
                        <ComboBoxItem Content="Blinds" Tag="Blinds" />
                        <ComboBoxItem Content="Wipe" Tag="Wipe" />
                        <ComboBoxItem Content="Surprise me" Tag="Random" />
                        <ComboBoxItem Content="None" Tag="None" />
                    </ComboBox>
                </controls:SettingRow>
                <controls:SettingRow Description="Turns like a record while a song plays." Header="Spinning cover">
                    <ToggleSwitch
                        x:Name="SpinningCoverSwitch"
                        AutomationProperties.Name="Spinning cover"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSpinningCoverToggled" />
                </controls:SettingRow>
                <controls:SettingRow Description="Behind looks like Liquid Glass." Header="Blurred cover background">
                    <ToggleSwitch
                        x:Name="BlurredCoverSwitch"
                        AutomationProperties.Name="Blurred cover background"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="OnBlurredCoverToggled" />
                </controls:SettingRow>
                <TextBlock
                    x:Name="BlurredCoverHint"
                    Margin="16,0,16,0"
                    Style="{StaticResource ResonateCaptionTextStyle}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </controls:SettingsGroup>

        <Expander
            x:Name="CustomizeExpander"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Collapsed="OnCustomizeCollapsed"
            Expanding="OnCustomizeExpanding">
            <Expander.Header>
                <StackPanel Padding="0,12" Spacing="2">
                    <TextBlock Style="{StaticResource ResonateBodyTextStyle}" Text="Customize" />
                    <TextBlock
                        x:Name="CustomizeHint"
                        Style="{StaticResource ResonateCaptionTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Expander.Header>

            <StackPanel Spacing="6">
                <!-- Colours -->
                <TextBlock Style="{StaticResource StudioSectionTextStyle}" Text="COLOURS" />
                <controls:SettingRow Header="Mode">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button
                            Click="OnBaseClick"
                            Content="Light"
                            Style="{StaticResource ResonateSubtleButtonStyle}"
                            Tag="Light" />
                        <Button
                            Click="OnBaseClick"
                            Content="Dark"
                            Style="{StaticResource ResonateSubtleButtonStyle}"
                            Tag="Dark" />
                        <Button
                            Click="OnBaseClick"
                            Content="Black"
                            Style="{StaticResource ResonateSubtleButtonStyle}"
                            Tag="Black" />
                    </StackPanel>
                </controls:SettingRow>
                <VariableSizedWrapGrid
                    x:Name="SwatchGrid"
                    ItemHeight="52"
                    ItemWidth="164"
                    Orientation="Horizontal" />
                <controls:SettingRow Description="Takes its colour from the song." Header="Accent follows the cover">
                    <ToggleSwitch
                        x:Name="AdaptiveAccentSwitch"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="OnAdaptiveAccentToggled" />
                </controls:SettingRow>

                <!-- Background and materials -->
                <TextBlock Style="{StaticResource StudioSectionTextStyle}" Text="BACKGROUND" />
                <controls:SettingRow Header="Backdrop">
                    <ComboBox
                        x:Name="BackdropChoice"
                        SelectionChanged="OnChoiceChanged"
                        Style="{StaticResource StudioComboStyle}">
                        <ComboBoxItem Content="Solid colour" Tag="Solid" />
                        <ComboBoxItem Content="Gradient" Tag="Gradient" />
                        <ComboBoxItem Content="Song cover" Tag="Artwork" />
                        <ComboBoxItem Content="Mica (Windows)" Tag="Mica" />
                        <ComboBoxItem Content="Acrylic (Windows)" Tag="Acrylic" />
                    </ComboBox>
                </controls:SettingRow>
                <controls:SettingRow
                    x:Name="GradientAngleRow"
                    Header="Gradient angle">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Slider
                            x:Name="GradientAngleSlider"
                            Maximum="360"
                            Minimum="0"
                            StepFrequency="5"
                            Style="{StaticResource StudioSliderStyle}"
                            ValueChanged="OnSliderChanged" />
                        <TextBlock x:Name="GradientAngleText" Style="{StaticResource StudioValueTextStyle}" />
                    </StackPanel>
                </controls:SettingRow>
                <controls:SettingRow
                    x:Name="TintRow"
                    Header="Tint">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Slider
                            x:Name="TintSlider"
                            Maximum="100"
                            Minimum="0"
                            StepFrequency="1"
                            Style="{StaticResource StudioSliderStyle}"
                            ValueChanged="OnSliderChanged" />
                        <TextBlock x:Name="TintText" Style="{StaticResource StudioValueTextStyle}" />
                    </StackPanel>
                </controls:SettingRow>
                <controls:SettingRow Description="Lower for glass." Header="Panel opacity">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Slider
                            x:Name="PanelOpacitySlider"
                            Maximum="100"
                            Minimum="0"
                            StepFrequency="1"
                            Style="{StaticResource StudioSliderStyle}"
                            ValueChanged="OnSliderChanged" />
                        <TextBlock x:Name="PanelOpacityText" Style="{StaticResource StudioValueTextStyle}" />
                    </StackPanel>
                </controls:SettingRow>

                <!-- Shape -->
                <TextBlock Style="{StaticResource StudioSectionTextStyle}" Text="SHAPE" />
                <controls:SettingRow Header="Corners">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Slider
                            x:Name="CornerSlider"
                            Maximum="32"
                            Minimum="0"
                            StepFrequency="1"
                            Style="{StaticResource StudioSliderStyle}"
                            ValueChanged="OnSliderChanged" />
                        <TextBlock x:Name="CornerText" Style="{StaticResource StudioValueTextStyle}" />
                    </StackPanel>
                </controls:SettingRow>
                <controls:SettingRow Header="Buttons">
                    <ComboBox
                        x:Name="ButtonsChoice"
                        SelectionChanged="OnChoiceChanged"
                        Style="{StaticResource StudioComboStyle}">
                        <ComboBoxItem Content="Round" Tag="Round" />
                        <ComboBoxItem Content="Rounded square" Tag="Rounded" />
                        <ComboBoxItem Content="Square" Tag="Square" />
                    </ComboBox>
                </controls:SettingRow>
                <controls:SettingRow Header="Outlines">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Slider
                            x:Name="BorderSlider"
                            Maximum="4"
                            Minimum="0"
                            StepFrequency="0.5"
                            Style="{StaticResource StudioSliderStyle}"
                            ValueChanged="OnSliderChanged" />
                        <TextBlock x:Name="BorderText" Style="{StaticResource StudioValueTextStyle}" />
                    </StackPanel>
                </controls:SettingRow>
                <controls:SettingRow Header="Spacing">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Slider
                            x:Name="GapSlider"
                            Maximum="24"
                            Minimum="0"
                            StepFrequency="1"
                            Style="{StaticResource StudioSliderStyle}"
                            ValueChanged="OnSliderChanged" />
                        <TextBlock x:Name="GapText" Style="{StaticResource StudioValueTextStyle}" />
                    </StackPanel>
                </controls:SettingRow>
                <controls:SettingRow Header="Shadows">
                    <ComboBox
                        x:Name="ShadowChoice"
                        SelectionChanged="OnChoiceChanged"
                        Style="{StaticResource StudioComboStyle}">
                        <ComboBoxItem Content="None" Tag="None" />
                        <ComboBoxItem Content="Soft" Tag="Soft" />
                        <ComboBoxItem Content="Deep" Tag="Strong" />
                        <ComboBoxItem Content="Glow in the accent" Tag="Glow" />
                        <ComboBoxItem Content="Hard, offset" Tag="Hard" />
                    </ComboBox>
                </controls:SettingRow>

                <!-- Text -->
                <TextBlock Style="{StaticResource StudioSectionTextStyle}" Text="TEXT" />
                <controls:SettingRow Description="Or type any installed font." Header="Headings">
                    <ComboBox
                        x:Name="DisplayFontChoice"
                        IsEditable="True"
                        SelectionChanged="OnFontChanged"
                        Style="{StaticResource StudioComboStyle}"
                        TextSubmitted="OnFontTextSubmitted" />
                </controls:SettingRow>
                <controls:SettingRow Header="Body text">
                    <ComboBox
                        x:Name="TextFontChoice"
                        IsEditable="True"
                        SelectionChanged="OnFontChanged"
                        Style="{StaticResource StudioComboStyle}"
                        TextSubmitted="OnFontTextSubmitted" />
                </controls:SettingRow>

                <!-- Player -->
                <TextBlock Style="{StaticResource StudioSectionTextStyle}" Text="PLAYER" />
                <controls:SettingRow Header="Progress bar">
                    <StackPanel Spacing="10">
                        <ComboBox
                            x:Name="ProgressChoice"
                            SelectionChanged="OnChoiceChanged"
                            Style="{StaticResource StudioComboStyle}">
                            <ComboBoxItem Content="Line" Tag="Line" />
                            <ComboBoxItem Content="Bold" Tag="Bold" />
                            <ComboBoxItem Content="Gradient" Tag="Gradient" />
                            <ComboBoxItem Content="Wave" Tag="Wave" />
                            <ComboBoxItem Content="Hairline" Tag="Minimal" />
                        </ComboBox>
                        <controls:SeekBar
                            x:Name="ProgressPreview"
                            AutomationProperties.Name="Progress bar preview"
                            IsAdvancing="True"
                            IsHitTestVisible="False"
                            IsTabStop="False"
                            Maximum="600"
                            Value="240" />
                    </StackPanel>
                </controls:SettingRow>
                <controls:SettingRow Header="Play button">
                    <ComboBox
                        x:Name="PlayButtonChoice"
                        SelectionChanged="OnChoiceChanged"
                        Style="{StaticResource StudioComboStyle}">
                        <ComboBoxItem Content="Filled" Tag="Filled" />
                        <ComboBoxItem Content="Outline" Tag="Outline" />
                        <ComboBoxItem Content="Symbol only" Tag="Plain" />
                    </ComboBox>
                </controls:SettingRow>
                <controls:SettingRow Header="Cover">
                    <ComboBox
                        x:Name="CoverChoice"
                        SelectionChanged="OnChoiceChanged"
                        Style="{StaticResource StudioComboStyle}">
                        <ComboBoxItem Content="Rounded" Tag="Rounded" />
                        <ComboBoxItem Content="Square" Tag="Square" />
                        <ComboBoxItem Content="Vinyl" Tag="Vinyl" />
                    </ComboBox>
                </controls:SettingRow>

                <!-- Keeping and sharing -->
                <StackPanel
                    Margin="0,14,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Click="OnSaveAsClick"
                        Content="Save as…"
                        Style="{StaticResource ResonateAccentButtonStyle}" />
                    <Button
                        Click="OnCopyClick"
                        Content="Copy as text"
                        Style="{StaticResource ResonateSubtleButtonStyle}"
                        ToolTipService.ToolTip="Copies this look, to paste into Resonate on another computer or share it" />
                    <Button
                        Click="OnPasteClick"
                        Content="Paste a look"
                        Style="{StaticResource ResonateSubtleButtonStyle}" />
                </StackPanel>
                <!-- Not for presets, which never change (see ShowDeleteButton) -->
                <Button
                    x:Name="DeleteLookButton"
                    Click="OnDeleteLookClick"
                    Style="{StaticResource ResonateSubtleButtonStyle}"
                    Visibility="Collapsed" />
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
