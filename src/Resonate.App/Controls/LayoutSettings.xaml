<?xml version="1.0" encoding="utf-8"?>
<!--
  The Layout tab of Settings: how pages open, which links and buttons
  show, what song lists show, and how large everything is drawn. See
  LayoutSettings.xaml.cs.
-->
<UserControl
    x:Class="Resonate.App.Controls.LayoutSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Resonate.App.Controls">

    <StackPanel x:Name="Sections" Spacing="20">
        <!-- How pages open, and Home's background -->
        <controls:SettingsGroup Header="Pages">
            <StackPanel x:Name="PagesRows" Spacing="6">
                <controls:SettingRow Header="Page animation">
                    <ComboBox
                        x:Name="PageAnimationChoice"
                        MinWidth="170"
                        AutomationProperties.Name="Page animation"
                        SelectionChanged="OnPageAnimationChanged">
                        <ComboBoxItem Content="Default" Tag="Default" />
                        <ComboBoxItem Content="Rise" Tag="Rise" />
                        <ComboBoxItem Content="Drill in" Tag="DrillIn" />
                        <ComboBoxItem Content="Slide" Tag="Slide" />
                        <ComboBoxItem Content="Fade" Tag="Fade" />
                        <ComboBoxItem Content="None" Tag="None" />
                    </ComboBox>
                </controls:SettingRow>
            </StackPanel>
        </controls:SettingsGroup>

        <!-- Links in the sidebar and buttons in the title bar (Home and Settings always show) -->
        <controls:SettingsGroup Header="Sidebar and buttons">
            <StackPanel Spacing="6">
                <controls:SettingRow Header="Sidebar runs full height">
                    <ToggleSwitch
                        x:Name="SidebarFullHeightSwitch"
                        MinWidth="0"
                        AutomationProperties.Name="Sidebar runs full height"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSidebarFullHeightToggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="Search">
                    <ToggleSwitch
                        x:Name="SearchLinkSwitch"
                        MinWidth="0"
                        AutomationProperties.Name="Search in the sidebar"
                        OffContent=""
                        OnContent=""
                        Toggled="OnLinkToggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="Liked Songs">
                    <ToggleSwitch
                        x:Name="LikedLinkSwitch"
                        MinWidth="0"
                        AutomationProperties.Name="Liked Songs in the sidebar"
                        OffContent=""
                        OnContent=""
                        Toggled="OnLinkToggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="Local Files">
                    <ToggleSwitch
                        x:Name="LocalFilesLinkSwitch"
                        MinWidth="0"
                        AutomationProperties.Name="Local Files in the sidebar"
                        OffContent=""
                        OnContent=""
                        Toggled="OnLinkToggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="DJ">
                    <ToggleSwitch
                        x:Name="DjLinkSwitch"
                        MinWidth="0"
                        AutomationProperties.Name="DJ in the sidebar"
                        OffContent=""
                        OnContent=""
                        Toggled="OnLinkToggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="Playlist covers">
                    <ToggleSwitch
                        x:Name="PlaylistCoversSwitch"
                        MinWidth="0"
                        AutomationProperties.Name="Playlist covers"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSongListToggled" />
                </controls:SettingRow>
                <controls:SettingRow x:Name="MiniPlayerButtonRow" Header="Mini player button">
                    <ToggleSwitch
                        x:Name="MiniPlayerButtonSwitch"
                        MinWidth="0"
                        AutomationProperties.Name="Mini player button"
                        OffContent=""
                        OnContent=""
                        Toggled="OnMiniPlayerButtonToggled" />
                </controls:SettingRow>
            </StackPanel>
        </controls:SettingsGroup>

        <!-- Song lists: covers and optional columns, the user's own; read when a list opens -->
        <controls:SettingsGroup Header="Song lists">
            <StackPanel Spacing="6">
                <controls:SettingRow Header="Song covers">
                    <ToggleSwitch
                        x:Name="SongCoversSwitch"
                        MinWidth="0"
                        AutomationProperties.Name="Song covers"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSongListToggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="Column names">
                    <ToggleSwitch
                        x:Name="ColumnNamesSwitch"
                        MinWidth="0"
                        AutomationProperties.Name="Column names"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSongListToggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="#">
                    <ToggleSwitch
                        x:Name="NumberColumnSwitch"
                        MinWidth="0"
                        AutomationProperties.Name="Number column"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSongListToggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="Album">
                    <ToggleSwitch
                        x:Name="AlbumColumnSwitch"
                        MinWidth="0"
                        AutomationProperties.Name="Album column"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSongListToggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="Year">
                    <ToggleSwitch
                        x:Name="YearColumnSwitch"
                        MinWidth="0"
                        AutomationProperties.Name="Year column"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSongListToggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="Date added">
                    <ToggleSwitch
                        x:Name="AddedColumnSwitch"
                        MinWidth="0"
                        AutomationProperties.Name="Date added column"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSongListToggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="Like">
                    <ToggleSwitch
                        x:Name="LikeColumnSwitch"
                        MinWidth="0"
                        AutomationProperties.Name="Like column"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSongListToggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="Length">
                    <ToggleSwitch
                        x:Name="DurationColumnSwitch"
                        MinWidth="0"
                        AutomationProperties.Name="Length column"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSongListToggled" />
                </controls:SettingRow>
                <controls:SettingRow Description="Sends your songs' Spotify IDs to ReccoBeats." Header="Song stats">
                    <ToggleSwitch
                        x:Name="SongStatsSwitch"
                        MinWidth="0"
                        AutomationProperties.Name="Song stats"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSongListToggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="BPM">
                    <ToggleSwitch
                        x:Name="BpmColumnSwitch"
                        MinWidth="0"
                        AutomationProperties.Name="BPM column"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSongListToggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="Key">
                    <ToggleSwitch
                        x:Name="KeyColumnSwitch"
                        MinWidth="0"
                        AutomationProperties.Name="Key column"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSongListToggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="Loudness">
                    <ToggleSwitch
                        x:Name="LoudnessColumnSwitch"
                        MinWidth="0"
                        AutomationProperties.Name="Loudness column"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSongListToggled" />
                </controls:SettingRow>
                <controls:SettingRow Header="Energy">
                    <ToggleSwitch
                        x:Name="EnergyColumnSwitch"
                        MinWidth="0"
                        AutomationProperties.Name="Energy column"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSongListToggled" />
                </controls:SettingRow>
            </StackPanel>
        </controls:SettingsGroup>

        <!-- Size: the user's own, kept whatever look is in use (not part of a look); steps from AppScale -->
        <controls:SettingsGroup Header="Size">
            <StackPanel Spacing="6">
                <controls:SettingRow x:Name="AppSizeRow" Header="App size">
                    <ComboBox
                        x:Name="AppSizeChoice"
                        MinWidth="100"
                        AutomationProperties.Name="App size"
                        SelectionChanged="OnAppSizeChanged" />
                </controls:SettingRow>
                <controls:SettingRow Header="Text size">
                    <ComboBox
                        x:Name="TextSizeChoice"
                        MinWidth="100"
                        AutomationProperties.Name="Text size"
                        SelectionChanged="OnTextSizeChanged" />
                </controls:SettingRow>
                <controls:SettingRow Header="Cover size">
                    <ComboBox
                        x:Name="CoverSizeChoice"
                        MinWidth="100"
                        AutomationProperties.Name="Cover size"
                        SelectionChanged="OnCoverSizeChanged" />
                </controls:SettingRow>
            </StackPanel>
        </controls:SettingsGroup>
    </StackPanel>
</UserControl>
