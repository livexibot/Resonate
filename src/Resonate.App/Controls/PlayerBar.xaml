<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Resonate.App.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Height="88"
        Padding="20,0"
        ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="220" />
            <ColumnDefinition Width="4*" MinWidth="320" />
            <ColumnDefinition Width="3*" MinWidth="180" />
        </Grid.ColumnDefinitions>

        <!-- Now playing -->
        <Grid VerticalAlignment="Center" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                x:Name="ArtworkFrame"
                Width="56"
                Height="56"
                Background="{StaticResource ResonateSurfaceHoverBrush}"
                CornerRadius="{StaticResource ResonateCornerMedium}">
                <FontIcon
                    x:Name="ArtworkGlyph"
                    FontFamily="{StaticResource ResonateIconFont}"
                    FontSize="20"
                    Foreground="{StaticResource ResonateTextTertiaryBrush}"
                    Glyph="&#xEC4F;" />
                <Image
                    x:Name="ArtworkImage"
                    ImageOpened="OnArtworkOpened"
                    Opacity="0"
                    Stretch="UniformToFill" />
            </Grid>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    x:Name="TitleText"
                    FontWeight="SemiBold"
                    Style="{StaticResource ResonateBodyTextStyle}"
                    Text="Nothing playing" />
                <TextBlock
                    x:Name="ArtistText"
                    Style="{StaticResource ResonateSecondaryTextStyle}"
                    Text="Pick a song to start" />
            </StackPanel>
        </Grid>

        <!-- Transport controls and the seek bar -->
        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="2">
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="14">
                <Button
                    x:Name="PreviousButton"
                    AutomationProperties.Name="Previous"
                    Click="OnPreviousClick"
                    Content="&#xE892;"
                    Style="{StaticResource ResonateIconButtonStyle}"
                    ToolTipService.ToolTip="Previous (Ctrl+Left)" />
                <Button
                    x:Name="PlayPauseButton"
                    AutomationProperties.Name="Play"
                    Click="OnPlayPauseClick"
                    Content="&#xE768;"
                    Style="{StaticResource ResonatePlayButtonStyle}"
                    ToolTipService.ToolTip="Play or pause (Space)" />
                <Button
                    x:Name="NextButton"
                    AutomationProperties.Name="Next"
                    Click="OnNextClick"
                    Content="&#xE893;"
                    Style="{StaticResource ResonateIconButtonStyle}"
                    ToolTipService.ToolTip="Next (Ctrl+Right)" />
            </StackPanel>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="PositionText"
                    VerticalAlignment="Center"
                    Style="{StaticResource ResonateCaptionTextStyle}"
                    Text="0:00"
                    TextAlignment="Right" />
                <Slider
                    x:Name="SeekSlider"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Position"
                    IsThumbToolTipEnabled="False"
                    Maximum="1"
                    Minimum="0"
                    ValueChanged="OnSeekValueChanged" />
                <TextBlock
                    x:Name="DurationText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource ResonateCaptionTextStyle}"
                    Text="0:00" />
            </Grid>
        </StackPanel>

        <!-- Volume -->
        <StackPanel
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="6">
            <Button
                x:Name="MuteButton"
                AutomationProperties.Name="Mute"
                Click="OnMuteClick"
                Content="&#xE767;"
                Style="{StaticResource ResonateIconButtonStyle}"
                ToolTipService.ToolTip="Mute" />
            <Slider
                x:Name="VolumeSlider"
                Width="128"
                VerticalAlignment="Center"
                AutomationProperties.Name="Volume"
                IsThumbToolTipEnabled="False"
                Maximum="100"
                Minimum="0"
                ValueChanged="OnVolumeValueChanged" />
        </StackPanel>
    </Grid>
</UserControl>
