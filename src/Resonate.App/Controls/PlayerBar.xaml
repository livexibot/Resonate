<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Resonate.App.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Resonate.App.Controls">

    <!--
      Docked along the bottom or the top, floating as a card under or above the
      panels, or hovering over the page as a centred pill or a mini bar in its
      corner (the look decides; see ThemeService and
      MainWindow.PlayerPlacement.cs), with the look's shadow behind it. A
      narrow bar leaves out the volume slider, then shrinks to the essentials
      (see ShowWidthClass). Its corners are set in code, as they follow its
      height.
    -->
    <controls:Elevation
        x:Name="BarHost"
        MaxWidth="{ThemeResource ResonatePlayerMaxWidth}"
        Margin="{ThemeResource ResonatePlayerMargin}"
        Level="Player">
        <Grid
            x:Name="Bar"
            Height="88"
            Padding="20,0"
            Background="{StaticResource ResonatePlayerBrush}"
            BorderBrush="{StaticResource ResonateBorderBrush}"
            BorderThickness="{ThemeResource ResonatePlayerBorderThickness}"
            ColumnSpacing="24"
            SizeChanged="OnBarSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NowPlayingColumn" Width="3*" MinWidth="220" />
                <ColumnDefinition x:Name="ControlsColumn" Width="4*" MinWidth="320" />
                <ColumnDefinition x:Name="VolumeColumn" Width="3*" MinWidth="180" />
            </Grid.ColumnDefinitions>

            <!--
              Now playing. Swipe it to skip (PlayerBar.Swipe.cs): the whole
              column takes the press, and the song inside moves.
            -->
            <Grid
                x:Name="NowPlayingArea"
                Background="{StaticResource ResonateTransparentBrush}"
                PointerCanceled="OnSongPointerCanceled"
                PointerCaptureLost="OnSongPointerCanceled"
                PointerMoved="OnSongPointerMoved"
                PointerPressed="OnSongPointerPressed"
                PointerReleased="OnSongPointerReleased">
                <Grid
                    x:Name="NowPlaying"
                    VerticalAlignment="Center"
                    ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ArtworkColumn" Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- The cover, with the look's shadow under it (it stays still while the cover spins). -->
                    <controls:Elevation x:Name="ArtworkShadow" Level="Item">
                        <Grid
                            x:Name="ArtworkFrame"
                            Width="56"
                            Height="56"
                            Background="{StaticResource ResonateSurfaceHoverBrush}"
                            CornerRadius="{ThemeResource ResonateCornerMedium}">
                            <FontIcon
                                x:Name="ArtworkGlyph"
                                FontFamily="{StaticResource ResonateIconFont}"
                                FontSize="20"
                                Foreground="{StaticResource ResonateTextTertiaryBrush}"
                                Glyph="&#xEC4F;" />
                            <Image
                                x:Name="ArtworkImage"
                                ImageOpened="OnArtworkOpened"
                                Opacity="0"
                                Stretch="UniformToFill" />
                            <!-- A record's centre (the vinyl cover style, or any cover while Spinning cover is on): a groove and the spindle hole. -->
                            <Grid x:Name="VinylCentre" Visibility="Collapsed">
                                <Ellipse
                                    Width="22"
                                    Height="22"
                                    Stroke="{StaticResource ResonateBorderBrush}"
                                    StrokeThickness="1" />
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Fill="{StaticResource ResonatePlayerBrush}"
                                    Stroke="{StaticResource ResonateBorderBrush}"
                                    StrokeThickness="1" />
                            </Grid>
                        </Grid>
                    </controls:Elevation>
                    <!--
                        The song above its artists; with Lyrics in the player
                        (a built-in plugin) "Song · Artist" on one line and the
                        line being sung and the next one under it
                        (PlayerBar.ShowLyricLine).
                    -->
                    <Grid
                        x:Name="SongText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        RowSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="TitleText"
                            Grid.ColumnSpan="3"
                            FontWeight="SemiBold"
                            PointerEntered="OnTitlePointerEntered"
                            PointerExited="OnTitlePointerExited"
                            Style="{StaticResource ResonateBodyTextStyle}"
                            Tapped="OnTitleTapped"
                            Text="Nothing playing" />
                        <TextBlock
                            x:Name="SongDotText"
                            Grid.Column="1"
                            Margin="6,0"
                            Style="{StaticResource ResonateSecondaryTextStyle}"
                            Text="·"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="ArtistText"
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Style="{StaticResource ResonateSecondaryTextStyle}"
                            Text="Pick a song to start" />
                        <TextBlock
                            x:Name="LyricLineText"
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Foreground="{StaticResource ResonateAccentBrush}"
                            MaxLines="2"
                            SizeChanged="OnLyricLineSizeChanged"
                            Style="{StaticResource ResonateCaptionTextStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="WrapWholeWords"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="NextLyricText"
                            Grid.Row="2"
                            Grid.ColumnSpan="3"
                            MaxLines="2"
                            Style="{StaticResource ResonateCaptionTextStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="WrapWholeWords"
                            Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- Transport controls and the seek bar -->
            <StackPanel
                x:Name="Transport"
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <StackPanel
                    x:Name="TransportButtons"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="14">
                    <ToggleButton
                        x:Name="ShuffleButton"
                        AutomationProperties.Name="Shuffle"
                        Click="OnShuffleClick"
                        Content="&#xE8B1;"
                        Style="{StaticResource ResonateToggleIconButtonStyle}"
                        ToolTipService.ToolTip="Shuffle, truly random (Ctrl+S)" />
                    <Button
                        x:Name="PreviousButton"
                        AutomationProperties.Name="Previous"
                        Click="OnPreviousClick"
                        Content="&#xE892;"
                        Style="{StaticResource ResonateIconButtonStyle}"
                        ToolTipService.ToolTip="Previous (Ctrl+Left)" />
                    <!-- The play button, glowing in the accent (or as the look's shadows go; see Elevation). -->
                    <controls:Elevation CornerRadius="{ThemeResource ResonatePlayButtonCorner}" Level="PlayButton">
                        <Button
                            x:Name="PlayPauseButton"
                            AutomationProperties.Name="Play"
                            Click="OnPlayPauseClick"
                            Content="&#xF5B0;"
                            Style="{StaticResource ResonatePlayButtonStyle}"
                            ToolTipService.ToolTip="Play or pause (Space)" />
                    </controls:Elevation>
                    <Button
                        x:Name="NextButton"
                        AutomationProperties.Name="Next"
                        Click="OnNextClick"
                        Content="&#xE893;"
                        Style="{StaticResource ResonateIconButtonStyle}"
                        ToolTipService.ToolTip="Next (Ctrl+Right)" />
                    <ToggleButton
                        x:Name="RepeatButton"
                        AutomationProperties.Name="Repeat"
                        Click="OnRepeatClick"
                        Content="&#xE8EE;"
                        Style="{StaticResource ResonateToggleIconButtonStyle}"
                        ToolTipService.ToolTip="Repeat (Ctrl+R)" />
                </StackPanel>
                <Grid x:Name="SeekRow" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PositionColumn" Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="DurationColumn" Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="PositionText"
                        Width="{ThemeResource ResonateTimeWidth}"
                        VerticalAlignment="Center"
                        Style="{StaticResource ResonateCaptionTextStyle}"
                        Text="0:00"
                        TextAlignment="Right" />
                    <controls:SeekBar
                        x:Name="PositionBar"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Position"
                        Maximum="1"
                        Minimum="0"
                        ValueChanged="OnSeekValueChanged" />
                    <TextBlock
                        x:Name="DurationText"
                        Grid.Column="2"
                        Width="{ThemeResource ResonateTimeWidth}"
                        VerticalAlignment="Center"
                        Style="{StaticResource ResonateCaptionTextStyle}"
                        Text="0:00" />
                </Grid>
            </StackPanel>

            <!--
              Plugins, the queue and the volume: in one row, or (Settings,
              Player, "Buttons above volume") the buttons in a row over the
              speaker and the slider (see ArrangeSide).
            -->
            <Grid
                x:Name="SideArea"
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel
                    x:Name="SideButtons"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <!-- Signal path, a built-in plugin (PlayerBar.SignalPath.cs): whether what plays is lossless. -->
                    <Border
                        x:Name="SignalSlot"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                    <!-- Commands from plugins that are on, such as the sleep timer (see PluginManager). -->
                    <Button
                        x:Name="PluginsButton"
                        AutomationProperties.Name="Plugins"
                        Click="OnPluginsClick"
                        Content="&#xEA86;"
                        Style="{StaticResource ResonateIconButtonStyle}"
                        ToolTipService.ToolTip="Plugins"
                        Visibility="Collapsed" />
                    <!-- Spotify Connect devices, with Spotify Web API only (see PlayerBar.Devices.cs). -->
                    <Button
                        x:Name="DeviceButton"
                        AutomationProperties.Name="Play on a device"
                        Click="OnDeviceClick"
                        Content="&#xE772;"
                        Style="{StaticResource ResonateIconButtonStyle}"
                        ToolTipService.ToolTip="Play on a device"
                        Visibility="Collapsed" />
                    <!-- Lyrics, a built-in plugin (PlayerBar.Lyrics.cs). -->
                    <Button
                        x:Name="LyricsButton"
                        AutomationProperties.Name="Lyrics"
                        Content="&#xE8D2;"
                        Style="{StaticResource ResonateIconButtonStyle}"
                        ToolTipService.ToolTip="Lyrics"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="QueueButton"
                        AutomationProperties.Name="Queue"
                        Click="OnQueueClick"
                        Content="&#xE8FD;"
                        Style="{StaticResource ResonateIconButtonStyle}"
                        ToolTipService.ToolTip="Queue" />
                </StackPanel>
                <StackPanel
                    x:Name="VolumeControls"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <!-- The mouse wheel over it sets the volume, also while the slider is left out. -->
                    <Button
                        x:Name="MuteButton"
                        AutomationProperties.Name="Mute"
                        Click="OnMuteClick"
                        Content="&#xE767;"
                        PointerWheelChanged="OnMuteWheelChanged"
                        Style="{StaticResource ResonateIconButtonStyle}"
                        ToolTipService.ToolTip="Mute (scroll to change the volume)" />
                    <controls:SeekBar
                        x:Name="VolumeBar"
                        Width="112"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Volume"
                        Maximum="100"
                        Minimum="0"
                        ValueChanged="OnVolumeValueChanged"
                        WheelStep="5" />
                </StackPanel>
            </Grid>
        </Grid>
    </controls:Elevation>
</UserControl>
