<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Resonate.App.Controls.QueuePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Resonate.App.ViewModels">

    <Grid Background="{StaticResource ResonateSurfaceBrush}" CornerRadius="{ThemeResource ResonateCornerLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="20,14,10,6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource ResonateSectionTextStyle}"
                Text="Queue" />
            <Button
                x:Name="CloseButton"
                Grid.Column="1"
                AutomationProperties.Name="Close the queue"
                Click="OnCloseClick"
                Content="&#xE711;"
                Style="{StaticResource ResonateIconButtonStyle}"
                ToolTipService.ToolTip="Close" />
        </Grid>

        <ListView
            x:Name="UpcomingList"
            Grid.Row="1"
            Padding="8,0,8,16"
            ContextRequested="OnUpcomingContextRequested"
            SelectionMode="None">
            <ListView.Header>
                <StackPanel Padding="12,6,12,0" Spacing="8">
                    <TextBlock Style="{StaticResource ResonateEyebrowTextStyle}" Text="NOW PLAYING" />
                    <Grid
                        x:Name="NowRow"
                        Height="56"
                        Background="{StaticResource ResonateTransparentBrush}"
                        ColumnSpacing="12"
                        ContextRequested="OnNowContextRequested">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            x:Name="NowCover"
                            Width="40"
                            Height="40"
                            Background="{StaticResource ResonateSurfaceHoverBrush}"
                            CornerRadius="{ThemeResource ResonateCornerSmall}">
                            <Image x:Name="NowImage" Stretch="UniformToFill" />
                        </Grid>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                x:Name="NowTitle"
                                Foreground="{StaticResource ResonateAccentBrush}"
                                Style="{StaticResource ResonateBodyTextStyle}"
                                Text="Nothing playing"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="NowArtists"
                                Style="{StaticResource ResonateSecondaryTextStyle}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            x:Name="NowDuration"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource ResonateSecondaryTextStyle}" />
                    </Grid>
                    <TextBlock
                        x:Name="SourceText"
                        Style="{StaticResource ResonateCaptionTextStyle}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="Collapsed" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource ResonateEyebrowTextStyle}"
                            Text="NEXT UP" />
                        <!-- Up next, a built-in plugin (QueuePanel.UpNext.cs): shown only while it is on. -->
                        <StackPanel
                            x:Name="UpNextTools"
                            Grid.Column="1"
                            Margin="0,-8,0,-8"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                            <Button
                                x:Name="UpNextShuffleButton"
                                AutomationProperties.Name="Shuffle what's next"
                                Click="OnUpNextShuffleClick"
                                Content="&#xE8B1;"
                                Style="{StaticResource ResonateIconButtonStyle}"
                                ToolTipService.ToolTip="Shuffle" />
                            <Button
                                x:Name="UpNextClearButton"
                                AutomationProperties.Name="Clear what's next"
                                Click="OnUpNextClearClick"
                                Content="&#xE74D;"
                                Style="{StaticResource ResonateIconButtonStyle}"
                                ToolTipService.ToolTip="Clear" />
                            <Button
                                x:Name="UpNextSaveButton"
                                AutomationProperties.Name="Save as playlist"
                                Click="OnUpNextSaveClick"
                                Content="&#xE74E;"
                                Style="{StaticResource ResonateIconButtonStyle}"
                                ToolTipService.ToolTip="Save as playlist" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ListView.Header>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TrackRow">
                    <Grid
                        Height="56"
                        Background="{StaticResource ResonateTransparentBrush}"
                        ColumnSpacing="12"
                        Opacity="{x:Bind RowOpacity}"
                        PointerCanceled="OnUpNextRowPointerExited"
                        PointerEntered="OnUpNextRowPointerEntered"
                        PointerExited="OnUpNextRowPointerExited">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Width="40"
                            Height="40"
                            Background="{x:Bind PlaceholderBrush}"
                            CornerRadius="{ThemeResource ResonateCornerSmall}">
                            <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
                        </Grid>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                Style="{StaticResource ResonateBodyTextStyle}"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Style="{StaticResource ResonateSecondaryTextStyle}"
                                Text="{x:Bind Artists}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource ResonateSecondaryTextStyle}"
                            Text="{x:Bind Duration}" />
                        <!-- Up next: shown in place of the length while the pointer is on the row. -->
                        <Button
                            Grid.Column="2"
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Remove from the queue"
                            Click="OnUpNextRemoveClick"
                            Content="&#xE711;"
                            FontSize="12"
                            Style="{StaticResource ResonateIconButtonStyle}"
                            ToolTipService.ToolTip="Remove"
                            Visibility="Collapsed" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.Footer>
                <StackPanel Padding="12,8,12,0" Spacing="10">
                    <TextBlock
                        x:Name="EmptyText"
                        Style="{StaticResource ResonateSecondaryTextStyle}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="NoteText"
                        Style="{StaticResource ResonateCaptionTextStyle}"
                        Text="Spotify shares about 20 songs ahead, and does not let other apps reorder or clear its queue. Right-click a song for more."
                        TextWrapping="Wrap" />
                </StackPanel>
            </ListView.Footer>
        </ListView>

        <ProgressRing
            x:Name="LoadingRing"
            Grid.Row="1"
            Width="28"
            Height="28"
            Margin="0,140,0,0"
            VerticalAlignment="Top"
            IsActive="False" />
    </Grid>
</UserControl>
