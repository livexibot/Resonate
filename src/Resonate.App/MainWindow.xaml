<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Resonate.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Resonate.App.Controls"
    xmlns:vm="using:Resonate.App.ViewModels"
    Title="Resonate">

    <Grid
        x:Name="RootGrid"
        Background="{StaticResource ResonateTransparentBrush}"
        PreviewKeyDown="OnRootPreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="F"
                Invoked="OnSearchAccelerator"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="L"
                Invoked="OnSearchAccelerator"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Right"
                Invoked="OnNextAccelerator"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Left"
                Invoked="OnPreviousAccelerator"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Left"
                Invoked="OnBackAccelerator"
                Modifiers="Menu" />
            <KeyboardAccelerator
                Key="S"
                Invoked="OnShuffleAccelerator"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="R"
                Invoked="OnRepeatAccelerator"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Up"
                Invoked="OnVolumeUpAccelerator"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Down"
                Invoked="OnVolumeDownAccelerator"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="N"
                Invoked="OnNewPlaylistAccelerator"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="M"
                Invoked="OnMiniPlayerAccelerator"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>

        <!-- Title bar (the whole strip drags the window, except the back button) -->
        <Grid x:Name="AppTitleBar" Background="{StaticResource ResonateTransparentBrush}">
            <StackPanel
                x:Name="TitleBarStart"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    x:Name="BackButton"
                    Width="40"
                    Height="32"
                    Margin="6,0,-4,0"
                    AutomationProperties.Name="Back"
                    Click="OnBackClick"
                    Content="&#xE72B;"
                    CornerRadius="{ThemeResource ResonateCornerSmall}"
                    FontSize="13"
                    Style="{StaticResource ResonateIconButtonStyle}"
                    ToolTipService.ToolTip="Back (Alt+Left)"
                    Visibility="Collapsed" />
                <Image
                    Width="16"
                    Height="16"
                    Margin="18,0,0,0"
                    Source="ms-appx:///Assets/Resonate-64.png" />
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource ResonateCaptionTextStyle}"
                    Text="Resonate" />
            </StackPanel>
            <!--
                Settings and the mini player, beside the window's own buttons (the
                margin keeps them clear; see UpdateTitleBarPassthrough). The Window
                shapes plugin puts its button first.
            -->
            <StackPanel
                x:Name="TitleBarButtons"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    x:Name="SettingsButton"
                    Width="40"
                    Height="32"
                    AutomationProperties.Name="Settings"
                    Click="OnSettingsClick"
                    Content="&#xE713;"
                    CornerRadius="{ThemeResource ResonateCornerSmall}"
                    FontSize="14"
                    Style="{StaticResource ResonateIconButtonStyle}"
                    ToolTipService.ToolTip="Settings"
                    Visibility="Collapsed" />
                <Button
                    x:Name="MiniPlayerButton"
                    Width="40"
                    Height="32"
                    AutomationProperties.Name="Mini player"
                    Click="OnMiniPlayerClick"
                    Content="&#xE8A7;"
                    CornerRadius="{ThemeResource ResonateCornerSmall}"
                    FontSize="13"
                    Style="{StaticResource ResonateIconButtonStyle}"
                    ToolTipService.ToolTip="Mini player (Ctrl+M)"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!--
            Everything under the title bar, drawn at the user's App size (see
            ApplyAppSize). The title bar keeps its size, like Windows' own
            buttons beside it.
        -->
        <controls:ScaleBox x:Name="ContentScale" Grid.Row="1">
            <!-- Library sidebar and pages -->
            <Grid
                x:Name="ShellGrid"
                Padding="{ThemeResource ResonateShellPadding}"
                ColumnSpacing="{ThemeResource ResonatePanelGap}">
                <!--
                    A third column for the queue pane is added while it is open (see ShowQueue).
                    The sidebar and the queue can be dragged wider or narrower (see LayOutPanes).
                -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="272" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--
                    A row for a player along the top, the panels, and a row for a
                    player underneath; the player's rows are empty while it is
                    elsewhere or hovers over the page (see MainWindow.PlayerPlacement.cs).
                -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- The panels' shadows, behind them -->
                <controls:Elevation
                    x:Name="SidebarElevation"
                    Grid.Row="1"
                    CornerRadius="{ThemeResource ResonateCornerLarge}" />
                <controls:Elevation
                    x:Name="ContentElevation"
                    Grid.Row="1"
                    Grid.Column="1"
                    CornerRadius="{ThemeResource ResonateCornerLarge}" />

                <Grid
                    x:Name="Sidebar"
                    Grid.Row="1"
                    Padding="6,10,6,8"
                    Background="{StaticResource ResonateSidebarBrush}"
                    BorderBrush="{StaticResource ResonateBorderBrush}"
                    BorderThickness="{ThemeResource ResonatePanelBorderThickness}"
                    CornerRadius="{ThemeResource ResonateCornerLarge}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- The selected link's pill: it glides behind the links to the one chosen (MainWindow.NavPill.cs). -->
                    <Border
                        x:Name="NavPill"
                        Height="36"
                        Margin="4,2,4,0"
                        VerticalAlignment="Top"
                        Background="{StaticResource ResonateAccentSoftBrush}"
                        CornerRadius="{ThemeResource ListViewItemCornerRadius}"
                        IsHitTestVisible="False"
                        Opacity="0">
                        <Border
                            Width="3"
                            Height="16"
                            HorizontalAlignment="Left"
                            Background="{StaticResource ResonateAccentBrush}"
                            CornerRadius="{ThemeResource ListViewItemSelectionIndicatorCornerRadius}" />
                    </Border>
                    <ListView
                        x:Name="NavList"
                        ItemsSource="{x:Bind NavItems}"
                        SelectionChanged="OnNavSelectionChanged"
                        SelectionMode="Single"
                        SizeChanged="OnNavListSizeChanged">
                        <ListView.Resources>
                            <!-- The pill shows which link is chosen, so the rows draw no selection of their own. -->
                            <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                            <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="ResonateTransparentBrush" />
                            <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="ResonateSurfaceHoverBrush" />
                            <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="ResonateSurfacePressedBrush" />
                        </ListView.Resources>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <StackPanel
                                    Height="40"
                                    HorizontalAlignment="{x:Bind ContentAlignment, Mode=OneWay}"
                                    Background="{StaticResource ResonateTransparentBrush}"
                                    Orientation="Horizontal"
                                    Spacing="14">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource ResonateIconFont}"
                                        FontSize="16"
                                        Foreground="{StaticResource ResonateTextSecondaryBrush}"
                                        Glyph="{x:Bind Glyph}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource ResonateBodyTextStyle}"
                                        Text="{x:Bind Label}"
                                        Visibility="{x:Bind LabelVisibility, Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid
                        x:Name="PlaylistsHeader"
                        Grid.Row="1"
                        Margin="16,14,8,4"
                        ColumnSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource ResonateEyebrowTextStyle}"
                            Text="PLAYLISTS" />
                        <Button
                            x:Name="PlaylistSortButton"
                            Grid.Column="1"
                            Width="30"
                            Height="30"
                            AutomationProperties.Name="Sort playlists"
                            Content="&#xE8CB;"
                            FontSize="13"
                            Style="{StaticResource ResonateIconButtonStyle}"
                            ToolTipService.ToolTip="Sort playlists">
                            <Button.Flyout>
                                <MenuFlyout x:Name="PlaylistSortMenu" Placement="BottomEdgeAlignedRight" />
                            </Button.Flyout>
                        </Button>
                        <Button
                            Grid.Column="2"
                            Width="30"
                            Height="30"
                            AutomationProperties.Name="New playlist"
                            Click="OnNewPlaylistClick"
                            Content="&#xE710;"
                            FontSize="13"
                            Style="{StaticResource ResonateIconButtonStyle}"
                            ToolTipService.ToolTip="New playlist (Ctrl+N)" />
                    </Grid>

                    <ListView
                        x:Name="PlaylistList"
                        Grid.Row="2"
                        AllowDrop="True"
                        CanDragItems="True"
                        CanReorderItems="True"
                        ContextRequested="OnPlaylistContextRequested"
                        DoubleTapped="OnPlaylistDoubleTapped"
                        DragItemsCompleted="OnPlaylistDragCompleted"
                        ItemsSource="{x:Bind Playlists}"
                        PointerExited="OnPlaylistPointerExited"
                        PointerMoved="OnPlaylistPointerMoved"
                        SelectionChanged="OnPlaylistSelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlaylistNavItem">
                                <Grid
                                    MinHeight="64"
                                    HorizontalAlignment="{x:Bind RowAlignment, Mode=OneWay}"
                                    Background="{StaticResource ResonateTransparentBrush}"
                                    ColumnSpacing="{x:Bind ColumnGap, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Bind CoverColumnWidth, Mode=OneWay}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        Width="48"
                                        Height="48"
                                        Background="{x:Bind Cover.Background, Mode=OneWay}"
                                        CornerRadius="{ThemeResource ResonateCornerSmall}"
                                        Visibility="{x:Bind CoverVisibility, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind Name}">
                                        <Image Source="{x:Bind Cover.Image}" Stretch="UniformToFill" />
                                    </Grid>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2"
                                        Visibility="{x:Bind TextVisibility, Mode=OneWay}">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{x:Bind NameBrush, Mode=OneWay}"
                                            Style="{StaticResource ResonateBodyTextStyle}"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Style="{StaticResource ResonateCaptionTextStyle}"
                                            Text="{x:Bind Details}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <FontIcon
                                        Grid.Column="2"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Playing"
                                        FontFamily="{StaticResource ResonateIconFont}"
                                        FontSize="14"
                                        Foreground="{StaticResource ResonateAccentBrush}"
                                        Glyph="&#xE767;"
                                        Visibility="{x:Bind SpeakerVisibility, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid
                    x:Name="ContentPanel"
                    Grid.Row="1"
                    Grid.Column="1"
                    Background="{StaticResource ResonateSurfaceBrush}"
                    BorderBrush="{StaticResource ResonateBorderBrush}"
                    BorderThickness="{ThemeResource ResonatePanelBorderThickness}"
                    CornerRadius="{ThemeResource ResonateCornerLarge}">
                    <!-- Back goes through the window's own history; the frame keeps none. -->
                    <Frame x:Name="ContentFrame" IsNavigationStackEnabled="False" />
                    <InfoBar
                        x:Name="MessageBar"
                        MaxWidth="720"
                        Margin="16"
                        VerticalAlignment="Top"
                        IsOpen="False" />

                    <!--
                        A new version downloading, then ready to install (see ShowUpdateProgress); its
                        width follows the page. The InfoBar's own fill is see-through, so it sits on the
                        panel colour to stay readable over the page. A hovering player lifts it (see
                        UpdatePlayerInset).
                    -->
                    <Border
                        x:Name="UpdateBarHost"
                        Margin="16"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource ResonateSurfaceBrush}"
                        CornerRadius="{ThemeResource ResonateCornerMedium}">
                        <InfoBar
                            x:Name="UpdateBar"
                            CloseButtonClick="OnUpdateBarCloseClick"
                            CornerRadius="{ThemeResource ResonateCornerMedium}"
                            IsOpen="False">
                            <StackPanel
                                x:Name="UpdateBarProgress"
                                Margin="0,0,0,14"
                                Spacing="6">
                                <ProgressBar x:Name="UpdateProgressBar" Maximum="1" />
                                <TextBlock
                                    x:Name="UpdateProgressText"
                                    Style="{StaticResource ResonateCaptionTextStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </InfoBar>
                    </Border>
                </Grid>

                <controls:QueuePanel
                    x:Name="QueuePane"
                    Grid.Row="1"
                    Grid.Column="2"
                    Visibility="Collapsed" />

                <!-- Settings, next to the page in the queue's place (see ShowSettings). -->
                <controls:SettingsPane
                    x:Name="SettingsPane"
                    Grid.Row="1"
                    Grid.Column="2"
                    Visibility="Collapsed" />

                <!-- Lyrics, a built-in plugin, in the same place (see MainWindow.Lyrics.cs). -->
                <controls:LyricsPane
                    x:Name="LyricsPane"
                    Grid.Row="1"
                    Grid.Column="2"
                    Visibility="Collapsed" />

                <!--
                  A special look's farther petals and snow, over the panels and
                  under the player, so they pass behind it (see SceneWeatherLayer).
                -->
                <Canvas
                    x:Name="WeatherBehindPlayer"
                    Grid.RowSpan="3"
                    Grid.ColumnSpan="99"
                    IsHitTestVisible="False" />

                <!--
                  The player, or the classic player in its place (added in code,
                  see MainWindow.ClassicPlayer.cs). It stays in this slot whatever
                  the layout; only where the slot sits changes (see
                  MainWindow.PlayerPlacement.cs). The slot has no background, so
                  clicks beside a hovering player reach the page.
                -->
                <Grid
                    x:Name="PlayerSlot"
                    Grid.Row="2"
                    Grid.ColumnSpan="99"
                    SizeChanged="OnPlayerSlotSizeChanged">
                    <controls:PlayerBar x:Name="PlayerBar" />
                </Grid>

                <!-- Grips in the gaps between the panels, above them (placed by PlaceSplitters). -->
                <controls:PaneSplitter
                    x:Name="SidebarSplitter"
                    Grid.Row="1"
                    HorizontalAlignment="Right" />
                <controls:PaneSplitter
                    x:Name="RightSplitter"
                    Grid.Row="1"
                    Grid.Column="2"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed" />
            </Grid>

            <!-- First run: connect to Spotify -->
            <Frame x:Name="SignInFrame" Visibility="Collapsed" />
        </controls:ScaleBox>
    </Grid>
</Window>
